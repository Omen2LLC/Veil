UiQPlayerInspectorEffectParamSlider::groove
{
    height: 5px;
    margin: 0 3px;
    padding: 0px -9px; /*9px = border 6px + margin 3px;*/
    border-width: 0px 6px;
    border-image: url(:/Player/Inspector/SliderGroove) 0 6 repeat repeat;
}
UiQPlayerInspectorEffectParamSlider::groove:disabled
{
    border-image: url(:/Player/Inspector/SliderGroove_disabled) 0 6 repeat repeat;
}
