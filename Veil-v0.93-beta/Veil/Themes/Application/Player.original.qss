    max-height: 20px;

    background: COLOR_TINT_GRAY;
}

QLineEdit[SkinId="PlayerInspectorTimecodeEdit"]
{
    background-color: transparent;
    border: none;
    color: COLOR_SMOKE_GRAY;
}
QLineEdit[SkinId="PlayerInspectorTimecodeEdit"]:disabled
{
    color: COLOR_SMOKE_GRAY_40;
}

UiQPhotoPageToolBarOnPlayer
{
    min-height: 42px;
    max-height: 42px;
    background-color: COLOR_ORCA_GRAY;
    border: none;
}

UiQPhotoPlayerInspectorContainer
{
    background-color: COLOR_OCTOPUS_GRAY;
    border: none;
    border-top: 1px solid COLOR_TINT_GRAY;
}

UiQPhotoPlayerFlagButton
{
    min-width: 39px;
    max-width: 39px;
    min-height: 18px;
    max-height: 18px;
    border: 1px solid transparent;
    border-radius: 3px;
    background-color: transparent;
    image-position: left center;
    image: url(:/Common/FlagsAndMarkers/Flag_None);
}

UiQPhotoPlayerFlagButton::menu-indicator
{
    subcontrol-origin: content;
    subcontrol-position: right center;
    margin: 0px 2px 0px 0px;
    padding: 0px;
    image: url(:/Common/Widgets/Arrow);
}

UiQPhotoPlayerFlagButton::menu-indicator:hover
{
    image: url(:/Common/Widgets/Arrow_hover);
}
UiQPhotoPlayerFlagButton::menu-indicator:pressed
{
    image: url(:/Common/Widgets/Arrow_push);
}

UiQPhotoPlayerWhiteLabel
{
    color: white;
    font-preset-name: FONT_PSYLOCKE_SEMIBOLD;
}

