UiQPlayerControlContainer
{
    border-style: none;
    border-top: 1px solid COLOR_TINT_GRAY;
    background-color: COLOR_ORCA_GRAY;
    min-height: 59px;
    max-height: 59px;
}

UiQPlayerControlPlaybackButton
{
    image-position: center center;
    background-color: transparent;
    margin: 0px;
    border-width: 0px;
    border-image: none;
    border-style: none;
    padding: 0px;

    min-width: 24px;
    max-width: 24px;
    min-height: 25px;
    max-height: 25px;
}

UiQPlayerControlPlaybackButton:hover,
UiQPlayerControlPlaybackButton:pressed
{
    padding: 0px;
}

