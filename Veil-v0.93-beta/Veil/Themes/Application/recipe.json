    "Previously user-confirmed menu/page-bar accents",
    "Shared sidebar and dialog body containers",
    "Media pool/clone containers",
    "Inspector content and effect header containers",
    "Deliver render settings and queue footer",
    "Color tool container backgrounds (grading visuals unchanged)",
    "Project Manager database/projects/body containers",
    "Empty Metadata panel with directly paired foreground/background",
    "Three explicitly named enabled Metadata text fields with paired foreground/background; native disabled and selection declarations retained",
    "Quick Export preset information header, paired foreground/background test",
    "Step 3 Media filmstrip information chrome; enabled name and duration labels paired with rose backing",
    "Step 3 Inspector enabled parameter/group labels paired with themed panel; native disabled and highlighted states retained",
    "Step 3 property-qualified filmstrip backing/labels and ordinary Inspector header title; active coral header state unchanged",
    "Step 3 enabled segmented text buttons: six native button classes, idle/hover/pressed/selected states; disabled rules and geometry unchanged; native test pending",
    "Step 3 direct enabled ordinary Inspector heading and filmstrip label pairs; disabled and active semantic label styles unchanged; native test pending",
    "Step 3 Edit timeline toolbar and shared viewer toolbar/transport backing; native images, geometry and states retained; custom timeline canvas not covered"
  ],
  "unsupported": [
    "Complete native workspace coverage",
    "Custom-painted timelines, viewers and grading visuals",
    "Fairlight DLL surfaces",
    "Bitmap recoloring and icon-heavy toolbars",
    "Operating-system dialogs and plug-in interfaces",
    "Native descendant paint not controlled by QSS"
  ],
  "preserved": [
    "Every original selector and non-color declaration",
    "Native icon artwork and geometry",
    "Native warning/error, footage, clip palette and grading/data colors",
    "Installed executable and regular shortcuts"
