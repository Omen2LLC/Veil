UiFLSoundLibraryWidgetImp
{
    background-color: COLOR_PENGUIN_GRAY;
}

UiQSoundLibrarySearchResultNumFrame
{
    background-color: COLOR_ORCA_GRAY;
    min-height: 19px; /* 21px = 19px + 2px from top and bottom borders */
    max-height: 19px;
    border-style: none;
    border-top: 1px solid COLOR_TINT_GRAY;
    border-bottom: 1px solid COLOR_TINT_GRAY;
}

UiQSoundLibrarySearchResultNumLabel
{
    padding-left: 10px;
    color: COLOR_SMOKE_GRAY;
    font-preset-name: FONT_PSYLOCKE;
}

UiQSoundLibraryPlayerClipNameLabel
{
    color: white;
    font-preset-name: FONT_MAGNETO;
}

UiQSmallTextButton[SkinId="SmallTextButton"]
{
    min-width: 62px; /* Total width is 90px, however we need to account for 14px padding on each side*/
    max-width: 80px;
}

UiQSoundLibraryNotConnectedLabel
{
    color: COLOR_JELLYFISH_GRAY;
    font-preset-name: FONT_SENTINAL_LIGHT;
}

UiQSoundLibraryPlayerWidgetViewerFrame
{
    margin: 0px 20px 0px 20px;
    min-height: 94px;
    max-height: 94px;
}

UiQPlayerControlContainer[SkinId="SoundLibraryPlayer"]
{
    /* Removed the border at the top of the player control for sound library player*/
    border-top: 0px;
    background-color: COLOR_PENGUIN_GRAY;
}

UiQSoundLibrarySearchWidgetContainer
{
    /* Right margin need to account for the collapseExpandBtn icon pixmap inner padding*/
    /* Bottom margin is set dynamically based on whether the search layout is expanded due to the collapseExpandBtn icon pixmap bottom inner padding*/
    margin : 0px 17px 0px 20px;
}

UiQSoundLibraryAdvancedSearchButton
{
    image: url(:/Audio/SoundLibrary/ExpandPanel);
    image-position: center center;
    background-color: transparent;
    margin: 0px;
    border-width: 0px;
    border-image: none;
    border-style: none;
    padding: 0px;

    min-width: 25px;
    max-width: 25px;
    min-height: 25px;
    max-height: 25px;
}
UiQSoundLibraryAdvancedSearchButton:hover
{
    image: url(:/Audio/SoundLibrary/ExpandPanel_hover);
}
UiQSoundLibraryAdvancedSearchButton:pressed
{
    image: url(:/Audio/SoundLibrary/ExpandPanel_push);
}
UiQSoundLibraryAdvancedSearchButton:checked
{
    image: url(:/Audio/SoundLibrary/CollapsePanel);
}
UiQSoundLibraryAdvancedSearchButton:checked:hover
{
    image: url(:/Audio/SoundLibrary/CollapsePanel_hover);
}
UiQSoundLibraryAdvancedSearchButton:checked:pressed
{
    image: url(:/Audio/SoundLibrary/CollapsePanel_push);
}

QComboBox[SkinId="SoundLibrarySearchFilter"]
{
    color: white;
    font-preset-name: FONT_PSYLOCKE;
}

QComboBox[SkinId="SoundLibraryDatabase"]
{
    color: white;
    font-preset-name: FONT_PSYLOCKE;
}

UiQSoundLibraryPlayerWidgetCurTimecodeLabel
{
    color: white;
    font-preset-name: FONT_PSYLOCKE;
}

UiQSoundLibraryPlayerWidgetDurationLabel
{
    color: white;
    font-preset-name: FONT_PSYLOCKE;
}

UiQSoundLibrarySearchKeywordLineEdit
{
    border: 1px solid COLOR_TINT_GRAY;
    border-radius: 2px;
    background-color: COLOR_THUNDERSTORM_GRAY;
    color: white;
    min-height: 18px;
    max-height: 18px;
    selection-color: rgb(240, 240, 240);
    selection-background-color: rgba(255, 255, 255, 50);
    font-preset-name: FONT_PSYLOCKE;
}
UiQSoundLibrarySearchKeywordLineEdit:!read-only:focus
{
    border-color: COLOR_CORAL_RED;
    color: white;
    font-preset-name: FONT_DEFAULT_SEMIBOLD;
}
UiQSoundLibrarySearchKeywordLineEdit:disabled
{
    border-color: COLOR_TINT_GRAY_40;
    background-color: COLOR_THUNDERSTORM_GRAY_40;
    color: COLOR_DEFAULT_DISABLED;
}
