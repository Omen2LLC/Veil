UiQSectionHeaderTabButton
{
    background-color: transparent;
    border-style: none;
    border-bottom: 2px solid transparent;
    color: COLOR_DEFAULT;
    text-align: center;
    font-preset-name: FONT_MAGNETO_SEMIBOLD;
    padding: -1px 10px;
    min-height: 29px;
    max-height: 29px;
}
UiQSectionHeaderTabButton[SkinSizeMode="Large"]
{
    min-height: 29px;
    max-height: 29px;
}
UiQSectionHeaderTabButton[SkinSizeMode="Medium"],
UiQSectionHeaderTabButton[SkinSizeMode="Small"]
{
    min-height: 23px;
    max-height: 23px;
}
UiQSectionHeaderTabButton:hover,
UiQSectionHeaderTabButton:pressed
{
    border-bottom-color: COLOR_DEFAULT;
}
UiQSectionHeaderTabButton:checked,
UiQSectionHeaderTabButton:checked:hover,
UiQSectionHeaderTabButton:checked:pressed
{
    background-color: transparent;
    border-bottom-color: COLOR_CORAL_RED;
    color: white;
}
UiQSectionHeaderTabButton:disabled
{
    color: COLOR_DEFAULT_DISABLED;
}

UiQCutPageSectionHeaderTabButton
{
    background-color: transparent;
    border-style: none;
    border-bottom: 2px solid transparent;
    color: COLOR_DEFAULT;
    text-align: center;
    font-preset-name: FONT_MAGNETO_SEMIBOLD;
    padding: -1px 10px;
    min-height: 29px;
    max-height: 29px;
}
UiQCutPageSectionHeaderTabButton[SkinSizeMode="Large"]
{
    min-height: 44px;
    max-height: 44px;
}
UiQCutPageSectionHeaderTabButton:hover,
UiQCutPageSectionHeaderTabButton:pressed
{
    border-bottom-color: COLOR_DEFAULT;
}
