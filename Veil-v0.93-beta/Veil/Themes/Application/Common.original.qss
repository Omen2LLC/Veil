/**************************************************************/
/*  Push Buttons                                              */
/**************************************************************/
UiQTextButton
{
    min-width: 60px;
    min-height: 24px;
    max-height: 24px;
    border: 1px solid COLOR_JELLYFISH_GRAY;
    border-radius: 50%;
    background-color: none;
    color: COLOR_DEFAULT;
    font-preset-name: FONT_DEFAULT;
    padding: -1px 24px; /*left&right padding 25px: 1px on border*/
}
UiQTextButton[SkinSizeMode="Small"]
{
    font-preset-name: FONT_DEFAULT;
    min-height: 18px;
    max-height: 18px;
    border-radius: 50%;
}
UiQTextButton:hover
{
    border-color: COLOR_SQUID_GRAY;
    color: white;
}
UiQTextButton:pressed
{
    border-color: white;
    background-color: COLOR_OCTOPUS_GRAY;
}
UiQTextButton:disabled
{
    color: COLOR_DEFAULT_DISABLED;
    border-color: COLOR_JELLYFISH_GRAY_40;
}

UiMediumTextButton
{
    min-width: 60px;
    min-height: 24px;
    max-height: 24px;
    border: 1px solid COLOR_JELLYFISH_GRAY;
    border-radius: 50%;
    background-color: none;
    color: COLOR_DEFAULT;
    font-preset-name: FONT_DEFAULT;
    padding: -1px 11px; /*left&right padding 12px: 1px on border*/
}
UiMediumTextButton[SkinSizeMode="Small"]
{
    font-preset-name: FONT_DEFAULT;
    min-height: 18px;
    max-height: 18px;
    border-radius: 50%;
}
UiMediumTextButton:hover
{
    border-color: COLOR_SQUID_GRAY;
    color: white;
}
UiMediumTextButton:pressed
{
    border-color: white;
    background-color: COLOR_OCTOPUS_GRAY;
}
UiMediumTextButton:disabled
{
    color: COLOR_DEFAULT_DISABLED;
    border-color: COLOR_JELLYFISH_GRAY_40;
}

UiQSmallTextButton
{
    min-width: 44px;
    min-height: 22px;
    max-height: 22px;
    border: 1px solid COLOR_JELLYFISH_GRAY;
    border-radius: 50%;
    background-color: none;
    color: COLOR_DEFAULT;
    font-preset-name: FONT_SMOKEGRAY;
    padding: -1px 13px; /*left&right padding 14px: 1px on border*/
}
UiQSmallTextButton[SkinSizeMode="Small"]
{
    min-height: 18px;
    max-height: 18px;
    border-radius: 50%;
}
UiQSmallTextButton:hover
{
    border-color: COLOR_SQUID_GRAY;
    color: white;
}
UiQSmallTextButton:pressed
{
    border-color: white;
    background-color: COLOR_OCTOPUS_GRAY;
}
UiQSmallTextButton:disabled
{
    color: COLOR_DEFAULT_DISABLED;
    border-color: COLOR_JELLYFISH_GRAY_40;
}

UiQTinyTextButton
{
    border: 1px solid COLOR_TINT_GRAY;
    border-radius: 2px;
    color: COLOR_SMOKE_GRAY;
    min-height: 20px;
    max-height: 20px;
    min-width: 31px;
    font-preset-name: FONT_DEFAULT;
    padding: -1px 3px;
}

UiQTinyTextButton:hover,
UiQTinyTextButton:pressed
{
    color: white;
}
UiQTinyTextButton:checked
{
    background-color: COLOR_OCTOPUS_GRAY;
}
UiQTinyTextButton:disabled
{
    border-color: COLOR_JELLYFISH_GRAY_40;
    color: COLOR_SQUID_GRAY_40;
}

UiQDefaultTextButton
{
    min-width: 60px;
    min-height: 24px;
    max-height: 24px;
    border: 1px solid COLOR_JELLYFISH_GRAY;
    border-radius: 50%;
    background-color: none;
    color: COLOR_DEFAULT;
    font-preset-name: FONT_DEFAULT;
    padding: -1px 24px; /*left&right padding 25px: 1px on border*/
}
UiQDefaultTextButton:hover
{
    border-color: COLOR_SQUID_GRAY;
    color: white;
}
UiQDefaultTextButton:pressed
{
    border-color: white;
    background-color: COLOR_OCTOPUS_GRAY;
}
UiQDefaultTextButton:disabled
{
    color: COLOR_DEFAULT_DISABLED;
    border-color: COLOR_JELLYFISH_GRAY_40;
}
UiQDefaultTextButton:default
{
    border-color: COLOR_CORAL_RED;
    color: COLOR_SQUID_GRAY;
}
UiQDefaultTextButton:default:hover
{
    border-color:  COLOR_CORAL_RED;
    color: white;
}
UiQDefaultTextButton:default:pressed
{
    background-color: COLOR_OCTOPUS_GRAY;
}
UiQDefaultTextButton:default:disabled
{
    color: COLOR_DEFAULT_DISABLED;
    border-color: COLOR_JELLYFISH_GRAY_40;
}

UiQBigTextButton
{
    border: 1px solid COLOR_JELLYFISH_GRAY;
    border-radius: 50%;
    background-color: transparent;
    color: COLOR_SQUID_GRAY;
    min-width: 92px;
    min-height: 26px;
    max-height: 26px;
    font-preset-name: FONT_DEFAULT;
    padding: -1px 24px; /*left&right padding 25px: 1px on border*/
}
UiQBigTextButton:hover
{
    border-color: COLOR_SQUID_GRAY;
    color: white;
}
UiQBigTextButton:pressed
{
    border-color: white;
    background-color: COLOR_OCTOPUS_GRAY;
}
UiQBigTextButton:default:disabled
{
    color: COLOR_SMOKE_GRAY_40;
    border-color: COLOR_JELLYFISH_GRAY_40;
}

UiQTextDropDownButton
{
    padding: 0px;
    border-style: none;
    background-color: transparent;
    color: white;
    font-preset-name: FONT_DEFAULT;
}
UiQTextDropDownButton::menu-indicator
{
    subcontrol-origin: content;
    subcontrol-position: right center;
    margin: 0 0 0 0;
    image: url(:/Common/Widgets/Arrow);
    height: 15px;
    width: 16px;
    left: 2px;
}
UiQTextDropDownButton::menu-indicator:hover
{
    image: url(:/Common/Widgets/Arrow_hover);
}
UiQTextDropDownButton::menu-indicator:pressed
{
    image: url(:/Common/Widgets/Arrow_push);
}
UiQTextDropDownButton::menu-indicator:disabled
{
    image: url(:/Common/Widgets/Arrow_disabled);
}
UiQTextDropDownButton:disabled
{
    color: COLOR_DEFAULT_DISABLED;
}
UiQTextDropDownButton[SkinId="SectionHeaderBarButton"]
{
    font-preset-name: FONT_MAGNETO_SEMIBOLD;
}

UiQGroupLeftButton
{
    min-width: 64px;
    min-height: 20px;
    max-height: 20px;
    border-style: none;
    border-left: 1px solid COLOR_TINT_GRAY;
    border-top: 1px solid COLOR_TINT_GRAY;
    border-bottom: 1px solid COLOR_TINT_GRAY;
    border-right: 1px solid COLOR_TINT_GRAY;
    border-top-left-radius: 2px;
    border-bottom-left-radius: 2px;
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;
    color: COLOR_DEFAULT;
    background-color: COLOR_ORCA_GRAY;
    padding: 0px 20px;
    font-preset-name: FONT_DEFAULT;
}
UiQGroupLeftButton:disabled
{
    color: COLOR_DEFAULT_DISABLED;
}
UiQGroupLeftButton:hover
{
    color: white;
}
UiQGroupLeftButton:pressed
{
    color: white;
}
UiQGroupLeftButton:checked
{
    color: white;
    background-color: COLOR_OCTOPUS_GRAY;
}
UiQGroupLeftButton:checked:disabled
{
    color: rgba(255, 255, 255, 102);
}
UiQGroupLeftButton:checked:hover
{
    color: white;
    background-color: COLOR_OCTOPUS_GRAY;
}
UiQGroupLeftButton:checked:pressed
{
    color: white;
    background-color: COLOR_OCTOPUS_GRAY;
}

