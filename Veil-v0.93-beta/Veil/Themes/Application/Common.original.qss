QMenu[SkinId="ActiveTrimMenu"]::item
{
    font-preset-name: FONT_PSYLOCKE;
    min-height: 15px;
    max-height: 15px;
    padding: 2px 7px 3px 23px;
}

UiQSectionFooterBar
{
    border-style: none;
    border-top: 1px solid COLOR_TINT_GRAY;
    background-color: COLOR_ORCA_GRAY;
    padding: 0px 8px 0px 8px;
    min-height: 29px;
    max-height: 29px;
}

UiQTaggedTextEditAddButton
{
    border-style: none;
    background-color: none;
    image-position: center center;
    min-width: 10px;
    max-width: 10px;
    min-height: 10px;
    max-height: 10px;
    image: url(:/Common/Widgets/AddIcon);
}
UiQTaggedTextEditAddButton:hover
{
    image: url(:/Common/Widgets/AddIcon_hover);
}
UiQTaggedTextEditAddButton:pressed,
UiQTaggedTextEditAddButton:checked
{
    image: url(:/Common/Widgets/AddIcon_push);
}
UiQTaggedTextEditAddButton:disabled
{
    image: url(:/Common/Widgets/AddIcon_disabled);
}
