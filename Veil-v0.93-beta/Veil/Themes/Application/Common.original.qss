/**************************************************************/
/*  Separators                                                */
/**************************************************************/
UiQ1pxVTintGraySeparator
{
    min-width: 1px;
    max-width: 1px;
    background-color: COLOR_TINT_GRAY;
}
UiQ1pxHTintGraySeparator
{
    min-height: 1px;
    max-height: 1px;
    background-color: COLOR_TINT_GRAY;
}
UiQ1pxVSmokeGraySeparator
{
    min-width: 1px;
    max-width: 1px;
    background-color: rgba(146, 146, 146, 77);/*smoke gray*/
}
UiQ1pxHSmokeGraySeparator
{
    min-height: 1px;
    max-height: 1px;
    background-color: rgba(146, 146, 146, 77);/*smoke gray*/
}
UiQ1pxVJellyFishGraySeparator
{
    min-width: 1px;
    max-width: 1px;
    background-color: COLOR_JELLYFISH_GRAY;
}
UiQ1pxHJellyFishGraySeparator
{
    min-height: 1px;
    max-height: 1px;
    background-color: COLOR_JELLYFISH_GRAY;
}
UiQ1pxHOctopusGraySeparator
{
    min-height: 1px;
    max-height: 1px;
    background-color: COLOR_OCTOPUS_GRAY;
}
UiQ1pxHPlanktonGraySeparator
{
    min-height: 1px;
    max-height: 1px;
    background-color: COLOR_PLANKTON_GRAY;
}
UiQ1pxVSealGraySeparator
{
    min-width: 1px;
    max-width: 1px;
    background-color: COLOR_SEAL_GRAY;
}
UiQ1pxHOrcaGraySeparator
{
    min-height: 1px;
    max-height: 1px;
