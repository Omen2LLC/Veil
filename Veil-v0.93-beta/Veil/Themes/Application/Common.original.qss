    color: white;
}
UiQCutPageSectionHeaderTabButton:disabled
{
    color: COLOR_DEFAULT_DISABLED;
}

UiQSectionBreadCrumbNavigator
{
    min-height: 28px;
    max-height: 28px;
    background-color: COLOR_ORCA_GRAY;
    border-style: none;
    border-bottom: 1px solid COLOR_TINT_GRAY;
    margin: 0px;
    padding: 0px 12px 0px 12px;
}

UiQSectionHeaderZoomSlider::groove
{
    height: 5px;
    margin: 0 3px;
    padding: 0px -9px; /*9px = border 6px + margin 3px;*/
    border-width: 0px 6px;
    border-image: url(:/Common/Widgets/HSliderGroove) 0 6 repeat repeat;
}
UiQSectionHeaderZoomSlider::groove:disabled
{
    border-image: url(:/Common/Widgets/HSliderGroove_Disabled) 0 6 repeat repeat;
}
UiQSectionHeaderZoomSlider::handle
{
    width: 11px;
    margin: -3px 0;
    image: url(:/Common/Widgets/SliderHandle);
}
UiQSectionHeaderZoomSlider::handle:pressed
{
    image: url(:/Common/Widgets/SliderHandlePush);
}
UiQSectionHeaderZoomSlider::handle:disabled
{
    image: url(:/Common/Widgets/SliderHandle_Disabled);
}

