}
UiQ1pxVWinterskyGraySeparator
{
    min-width: 1px;
    max-width: 1px;
    background-color: COLOR_WINTERSKY_GRAY;
}
UiQ1pxHBelugaGraySeparator
{
    min-height: 1px;
    max-height: 1px;
    background-color: COLOR_BELUGA_GRAY;
}

/**************************************************************/
/*  Borders                                                   */
/**************************************************************/
UiQTintGrayTopBorderFrame
{
    border-style: none;
    border-top: 1px solid COLOR_TINT_GRAY;
}
UiQTintGrayBottomBorderFrame
{
    border-style: none;
    border-bottom: 1px solid COLOR_TINT_GRAY;
}
UiQTintGrayHorizontalBordersFrame
{
    border-style: none;
    border-top: 1px solid COLOR_TINT_GRAY;
    border-bottom: 1px solid COLOR_TINT_GRAY;
}
UiQTintGrayRoundedBordersFrame
{
    border-style: none;
    border: 1px solid COLOR_TINT_GRAY;
    border-radius: 2px;
}

/**************************************************************/
/*  Menu                                                      */
/**************************************************************/
UiQBinViewHeaderMenu
{
    border: 1px solid COLOR_TINT_GRAY;
    border-radius: 1px;
    background-color: COLOR_PENGUIN_GRAY;
    padding: 4px 10px;
}
UiQBinViewHeaderMenu::item
{
    height: 20px;
    padding: 0px 27px 0px 0px;
    color: COLOR_DEFAULT;
    min-width: 100px;
    font-preset-name: FONT_DEFAULT;
}
UiQBinViewHeaderMenu::item:selected
{
    background-color: COLOR_THUNDERSTORM_GRAY;
    color: white;
}
UiQBinViewHeaderMenu::item:disabled
{
    background-color: none;
    color: COLOR_DEFAULT_DISABLED;
}
UiQBinViewHeaderMenu::separator
{
    height: 1px;
    background: COLOR_JELLYFISH_GRAY;
    margin: 3px 0px;
}
UiQBinViewHeaderMenu::indicator:checked
{
    image: url(:/Common/Widgets/MenuIndicator);
    width: 10px;
    height: 10px;
    margin-left: 7px;
}
UiQBinViewHeaderMenu::indicator:checked:selected
{
    image: url(:/Common/Widgets/MenuIndicatorActive);
}
UiQBinViewHeaderMenu::indicator:checked:disabled
{
    image: url(:/Common/Widgets/MenuIndicator_Disabled);
}
UiQBinViewHeaderMenu::icon
{
    padding: 0 6px;
}
UiQBinViewHeaderMenu::right-arrow
{
    image: url(:/Common/Widgets/ArrowRight);
    height: 11px;
    width: 11px;
    padding: 0px;
    margin-right: 8px;
}
UiQBinViewHeaderMenu::right-arrow:disabled
{
    image: url(:/Common/Widgets/ArrowRight_disabled);
}

/**************************************************************/
/*  Parameter Labels                                          */
/**************************************************************/
UiQParamLabel
{
    color: COLOR_DEFAULT;
}
UiQParamLabel:disabled
{
    color: COLOR_DEFAULT_DISABLED;
}
UiQDefaultWhiteLabel
{
    color: white;
    font-preset-name: FONT_PSYLOCKE;
}
UiQDefaultColorLabel
{
    font-preset-name: FONT_PSYLOCKE;
}
/**************************************************************/
/*  Dialogs                                                   */
/**************************************************************/
UiQDialogBackground
{
    border: 1px solid COLOR_LICORICE_GRAY;
}

UiQDialogTitle
{
    min-height: 28px;
    max-height: 28px;
    border-style: none;
    border-bottom: 1px solid COLOR_TINT_GRAY;
    background-color: COLOR_ORCA_GRAY;
    padding: 0px 8px 0px 10px;
}

UiQDialogTitle[SkinId="WithCloseButton"]
{
    padding-left: 5px;
}

UiQDialogBody
{
    background-color: COLOR_PENGUIN_GRAY;
    padding: 20px;
}

UiQDialogBodyWithoutPadding
{
    background-color: COLOR_PENGUIN_GRAY;
    padding: 0px;
}

UiQDialogBottomBar
{
    min-height: 60px;
    max-height: 60px;
    border-style: none;
    border-bottom: 1px solid COLOR_TINT_GRAY;
    background-color: COLOR_ORCA_GRAY;
    padding: 0px 20px 0px 20px;
}

UiQDialogBottomBarNoBorder
{
    min-height: 60px;
    max-height: 60px;
    padding: 0px 20px;
}

UiQDialogContentFrame
{
    background-color: COLOR_POSEIDON_GRAY;
    border: 1px solid COLOR_TINT_GRAY;
    border-radius: 2px;
}

UiQDialogWindowTitleLabel
{
    font-preset-name: FONT_MAGNETO_SEMIBOLD;
    color: white;
}
UiQDialogWindowTitleLabel[SkinId="ActivatedWindow"]
{
    font-preset-name: FONT_MAGNETO_SEMIBOLD;
    color: COLOR_CORAL_RED;
}

UiQMessageBoxDialog
{
    min-width: 500px;
    max-width: 500px;
}

UiQMessageBoxResizableDialog
{
    min-width: 500px;
}

UiQMessageBoxDialogWithoutIcon
{
    min-width: 460px;
    max-width: 460px;
}

UiQMessageBoxWideDialog
{
    min-width: 1024px;
    max-width: 1024px;
}

UiQMessageBoxIconLabel
{
    min-width: 52px;
    max-width: 52px;
    min-height: 48px;
    max-height: 48px;
}

UiQMessageBoxPrimaryText
{
    font-preset-name: FONT_APOCALYPSE_SEMIBOLD;
    color: rgb(251, 251, 251);
}

UiQMessageBoxSecondaryText
{
    font-preset-name: FONT_DEFAULT;
    color: COLOR_DEFAULT;
    selection-color: rgb(240, 240, 240);
    selection-background-color: rgba(255, 255, 255, 50);
    min-height: 34px;
}

UiQMessageBoxTreeWidgetContainer
{
    background-color: COLOR_PENGUIN_GRAY;
    border: 1px solid COLOR_TINT_GRAY;
    border-radius: 3px;
}

/**************************************************************/
/*  Layout Splitter Handle                                    */
/**************************************************************/
UiQLayoutSplitter
{
    background-color: COLOR_TINT_GRAY;
}

/**************************************************************/
/*  QSplitter                                                 */
/**************************************************************/
UiQSplitter::handle:horizontal
{
    background-color: COLOR_TINT_GRAY;
    width: 1px;
}
UiQSplitter::handle:vertical
{
    background-color: COLOR_TINT_GRAY;
    height: 1px;
}

UiQSectionDividerSplitter::handle:horizontal
{
    background-color: COLOR_JELLYFISH_GRAY;
    width: 1px;
}
UiQSectionDividerSplitter::handle:vertical
{
    background-color: COLOR_JELLYFISH_GRAY;
    height: 1px;
}

/**************************************************************/
/*  Section Header Bar                                        */
/**************************************************************/
UiQSectionHeaderBar
{
    border-style: none;
    border-bottom: 1px solid COLOR_TINT_GRAY;
    background-color: COLOR_ORCA_GRAY;
    padding: 0px 8px 0px 8px;
    min-height: 29px;
    max-height: 29px;
}
UiQSectionHeaderBar[SkinSizeMode="Large"]
{
    min-height: 29px;
    max-height: 29px;
}
UiQSectionHeaderBar[SkinSizeMode="Medium"],
UiQSectionHeaderBar[SkinSizeMode="Small"]
{
    min-height: 23px;
    max-height: 23px;
}

UiQSectionHeaderBar[SkinId="NGNavigationBar"]
{
    min-height: 28px;
    max-height: 28px;
}

UiQSectionHeaderBarWithCloseButton
{
    border-style: none;
    border-bottom: 1px solid COLOR_TINT_GRAY;
    background-color: COLOR_ORCA_GRAY;
    padding: 0px 8px 0px 3px;
    min-height: 29px;
    max-height: 29px;
}
UiQSectionHeaderBarWithCloseButton[SkinSizeMode="Large"]
{
    min-height: 29px;
    max-height: 29px;
}
UiQSectionHeaderBarWithCloseButton[SkinSizeMode="Medium"],
UiQSectionHeaderBarWithCloseButton[SkinSizeMode="Small"]
{
    min-height: 23px;
    max-height: 23px;
}

UiQSectionHeaderBarNonPaddingTransparent
{
    border-style: none;
    border-bottom: 1px solid COLOR_TINT_GRAY;
    background-color: transparent;
    padding: 0px;
    min-height: 29px;
    max-height: 29px;
}

UiQSectionHeaderTitle
{
    color: white;
    font-preset-name: FONT_MAGNETO_SEMIBOLD;
