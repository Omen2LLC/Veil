/**************************************************************/
/*  UiLineEdit                                                */
/**************************************************************/
UiQLineEditWithClearButton
{
    border: 1px solid COLOR_TINT_GRAY;
    border-radius: 2px;
    background-color: COLOR_THUNDERSTORM_GRAY;
    color: rgb(214, 214, 214);
    min-height: 18px;
    max-height: 18px;
    selection-color: rgb(240, 240, 240);
    selection-background-color: rgba(255, 255, 255, 50);
    font-preset-name: FONT_DEFAULT;
}
UiQLineEditWithClearButton:!read-only:focus
{
    border-color: COLOR_CORAL_RED;
    font-preset-name: FONT_DEFAULT_SEMIBOLD;
}
UiQLineEditWithClearButton:disabled
{
    border-color: COLOR_TINT_GRAY_40;
    background-color: COLOR_THUNDERSTORM_GRAY_40;
}

UiQLineEditLoadingLabel
{
    background-color: transparent;
    min-height: 18px;
    max-height: 18px;
    min-width: 18px;
    max-width: 18px;
}

/**************************************************************/
/*  List Widget Based Menu/Tab                                */
/**************************************************************/
UiQMenuListWidget
{
    show-decoration-selected: 1; /* make the selection span the entire width of the view */
}
UiQMenuListWidget::item
{
    min-height: 31px;
    max-height: 31px;
    height: 31px;
    padding: 0px 10px 0px 7px;
    color: COLOR_DEFAULT;
    font-preset-name: FONT_DEFAULT;
}
UiQMenuListWidget::item:selected
{
    background-color: COLOR_OCTOPUS_GRAY;
    color: white;
}
UiQMenuListWidget::item:selected:!active
{
   color: white;
}
UiQMenuListWidget::item:selected:active
{
   color: white;
}

UiQRoundedNightSkyGrayContainer
{
    border: 1px solid COLOR_NIGHTSKY_GRAY;
    border-radius: 3px;
}

UiQNightSkyGrayContainer
{
