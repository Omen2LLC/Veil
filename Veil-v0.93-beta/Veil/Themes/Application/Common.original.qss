/**************************************************************/
/*  Header Checkable                                          */
/**************************************************************/
UiQHeaderCheckBox
{
    color: white;
    spacing: 10px;
}
UiQHeaderCheckBox:disabled
{
    color: COLOR_DEFAULT_DISABLED;
}
UiQHeaderCheckBox::indicator
{
    width: 24px;
    height: 14px;
    position: absolute;
    top: 1px;
}
UiQHeaderCheckBox::indicator:unchecked
{
    image: url(:/Common/Widgets/Toggle);
}
UiQHeaderCheckBox::indicator:unchecked:hover
{
    image: url(:/Common/Widgets/Toggle_hover);
}
UiQHeaderCheckBox::indicator:unchecked:pressed
{
    image: url(:/Common/Widgets/Toggle_push);
}
UiQHeaderCheckBox::indicator:unchecked:disabled
{
    image: url(:/Common/Widgets/Toggle_disabled);
}
UiQHeaderCheckBox::indicator:checked
{
    image: url(:/Common/Widgets/Toggle_active);
}
UiQHeaderCheckBox::indicator:checked:hover
{
    image: url(:/Common/Widgets/Toggle_active_hover);
}
UiQHeaderCheckBox::indicator:checked:pressed
{
    image: url(:/Common/Widgets/Toggle_active_push);
}
UiQHeaderCheckBox::indicator:checked:disabled
{
    image: url(:/Common/Widgets/Toggle_active_disabled);
}
UiQHeaderCheckBox::indicator:indeterminate
{
    image: url(:/Common/Widgets/Toggle_partial);
}
UiQHeaderCheckBox::indicator:indeterminate:hover
{
    image: url(:/Common/Widgets/Toggle_partial_hover);
}
UiQHeaderCheckBox::indicator:indeterminate:pressed
{
    image: url(:/Common/Widgets/Toggle_partial_push);
}
