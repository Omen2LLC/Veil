UiQQuickExportPresetInfoHeaderBar{border-style:none;border-bottom:1px solid COLOR_TINT_GRAY;border-left:1px solid COLOR_TINT_GRAY;background-color:#E6CED5;color:COLOR_TINT_GRAY;font-preset-name:FONT_DEFAULT_SEMIBOLD;padding:0px 8px 0px 8px;min-height:29px;max-height:29px;}
UiQQuickExportRenderPresetContainer{background-color:COLOR_ORCA_GRAY;}
UiQQuickExportRenderPresetHeaderLabel{font-preset-name:FONT_DEFAULT_SEMIBOLD;}
UiQQuickExportPhotoConfigLabel{min-width:88px;max-width:88px;color:COLOR_BONES_GRAY;font-preset-name:FONT_PSYLOCKE;text-align:right;}
UiQQuickExportInfoFrame{border-style:none;border-bottom:1px solid COLOR_LUMINANCE_GRAY_20;}
UiQQuickExportInfoTupleFrame{min-height:30px;max-height:30px;}
UiQQuickExportInfoTupleTitleLabel{min-height:14px;max-height:14px;color:COLOR_SMOKE_GRAY;font-preset-name:FONT_PUNISHER;}
UiQQuickExportInfoTupleValueLabel{min-height:16px;max-height:16px;color:white;font-preset-name:FONT_DEFAULT_SEMIBOLD;}
UiQQuickExportInfoTupleValueLabel[SkinId="ExportFileNameValue"]{min-height:23px;max-height:23px;color:white;font-preset-name:FONT_WOLVERINE_SEMIBOLD;}
UiQQuickExportTargetFilePathLineEdit{border-radius:2px;color:COLOR_SMOKE_GRAY;min-height:18px;max-height:18px;padding-top:0px;padding-left:2px;border:1px solid COLOR_LICORICE_GRAY;background-color:COLOR_THUNDERSTORM_GRAY;selection-color:rgb(240, 240, 240);selection-background-color:rgba(255, 255, 255, 50);}
UiQQuickExportTargetFilePathLineEdit:read-only:focus{background-color:COLOR_THUNDERSTORM_GRAY;}
UiQQuickExportNameLineEdit{border-radius:2px;color:COLOR_SMOKE_GRAY;font-preset-name:FONT_PSYLOCKE;min-height:18px;max-height:18px;padding-top:0px;padding-left:2px;border:1px solid COLOR_LICORICE_GRAY;background-color:COLOR_THUNDERSTORM_GRAY;selection-color:rgb(240, 240, 240);selection-background-color:rgba(255, 255, 255, 50);}
UiQQuickExportNameLineEdit:read-only{border-color:transparent;background-color:COLOR_POSEIDON_GRAY;}
UiQQuickExportNameLineEdit:!read-only:focus{border-color:COLOR_CORAL_RED;}
UiPasswordLineEdit[SkinId="VimeoPasswordLineEdit"]{qproperty-infoTextColor:COLOR_SMOKE_GRAY;qproperty-textColor:COLOR_SMOKE_GRAY;qproperty-infoTextDisabledColor:COLOR_SMOKE_GRAY_40;qproperty-textDisabledColor:COLOR_SMOKE_GRAY_40;}
UiQQuickExportPrefixFrame{background-color:COLOR_PENGUIN_GRAY;border-style:none;border-top:1px solid COLOR_TINT_GRAY;}
UiQQuickExportBottomBtnContainer{border-style:none;background-color:COLOR_PENGUIN_GRAY;}
UiQQuickExportProgressDlgTitleLabel{min-height:20px;max-height:20px;color:white;font-preset-name:FONT_MAGNETO;}
UiQQuickExportProgressDlgStateLabel{min-height:20px;max-height:20px;color:COLOR_SMOKE_GRAY;font-preset-name:FONT_DEFAULT;}
UiQQuickExportProgressDlgRemainingTimeLabel{min-height:20px;max-height:20px;color:COLOR_SMOKE_GRAY;font-preset-name:FONT_DEFAULT;text-align:right;}
QCheckBox[SkinId="DataRateLimitCheckBox"]{padding-top:2px;spacing:0px;}
QCheckBox[SkinId="ExportPhotoConfigLabel"]{color:COLOR_BONES_GRAY;font-preset-name:FONT_PSYLOCKE;}
QComboBox[SkinId="ExportPhotoConfigComboBox"]{min-height:20px;max-height:20px;}
QLabel[SkinId="DataRateLimitLabel"]{font-preset-name:FONT_DEFAULT;color:COLOR_BONES_GRAY;}
QLabel[SkinId="DataRateLimitLabel"]:disabled{color:COLOR_DEFAULT_DISABLED;}
QTextEdit[SkinId="ExportPhotoTextEdit"]{min-height:18px;max-height:18px;padding-top:1px;padding-left:10px;padding-right:8px;}
QScrollBar[SkinId="RenderPresetsListScrollBar"]{background-color:COLOR_ORCA_GRAY;border-style:none;}
QSlider[SkinId="ExportPhotoConfigSlider"]{color:COLOR_SMOKE_GRAY;font-preset-name:FONT_PSYLOCKE;}