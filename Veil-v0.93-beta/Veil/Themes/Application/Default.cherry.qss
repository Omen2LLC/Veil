UiQCalMonthYearButton{border-style:none;background-color:transparent;min-height:24px;max-height:24px;padding:0px 10px 0px 0px;color:COLOR_DEFAULT;}
UiQCalMonthYearButton:hover, UiQCalMonthYearButton:pressed{padding:0px 10px 0px 0px;color:white;}
UiQCalMonthYearButton::menu-indicator{subcontrol-origin:content;subcontrol-position:right center;margin:0px 0px 0px 16px;image:url(:/Common/Widgets/Arrow);height:16px;width:16px;left:10px;}
UiQCalMonthYearButton::menu-indicator:hover{image:url(:/Common/Widgets/Arrow_hover);}
UiQCalMonthYearButton::menu-indicator:pressed{image:url(:/Common/Widgets/Arrow_push);}
UiQCalMonthYearButton::menu-indicator:disabled{image:url(:/Common/Widgets/Arrow_disabled);}
UiQCalPrevNextMonthButton{border-style:none;background-color:transparent;padding:0px;min-width:24px;max-width:24px;min-height:24px;max-height:24px;color:COLOR_DEFAULT;}
UiQCalPrevNextMonthButton:hover{padding:0px;color:white;}
UiQCalPrevNextMonthButton:pressed{padding:1px 0px 0px 1px;color:white;}
UiQCalYearSpinBox{color:COLOR_DEFAULT;border:1px solid COLOR_TINT_GRAY;border-radius:2px;background-color:COLOR_THUNDERSTORM_GRAY;padding:-1px 8px -1px 1px;margin:0px;min-height:18px;selection-color:rgb(240, 240, 240);selection-background-color:rgba(255, 255, 255, 50);}
UiQCalYearSpinBox:!read-only:focus{border-color:COLOR_CORAL_RED;color:white;}
UiQCalYearSpinBox:disabled{border-color:COLOR_TINT_GRAY_40;color:COLOR_SQUID_GRAY_40;background-color:COLOR_THUNDERSTORM_GRAY_40;}
UiQCalYearSpinBox::up-button{subcontrol-origin:border;width:11px;height:8px;right:2px;subcontrol-position:top right;image:url(:/Common/Widgets/SpinBoxArrowUp);top:1px;}
UiQCalYearSpinBox::up-button:hover{image:url(:/Common/Widgets/SpinBoxArrowUp_hover);}
UiQCalYearSpinBox::up-button:pressed{image:url(:/Common/Widgets/SpinBoxArrowUp_push);}
UiQCalYearSpinBox::up-button:disabled{image:url(:/Common/Widgets/SpinBoxArrowUp_disabled);}
UiQCalYearSpinBox::down-button{subcontrol-origin:border;width:11px;height:8px;right:2px;subcontrol-position:bottom right;image:url(:/Common/Widgets/SpinBoxArrowDown);bottom:1px;}
UiQCalYearSpinBox::down-button:hover{image:url(:/Common/Widgets/SpinBoxArrowDown_hover);}
UiQCalYearSpinBox::down-button:pressed{image:url(:/Common/Widgets/SpinBoxArrowDown_push);}
UiQCalYearSpinBox::down-button:disabled{image:url(:/Common/Widgets/SpinBoxArrowDown_disabled);}
QCheckBox{color:COLOR_DEFAULT;spacing:10px;min-height:17px;font-preset-name:FONT_DEFAULT;}
QCheckBox:disabled{color:COLOR_DEFAULT_DISABLED;}
QCheckBox::indicator{width:15px;height:15px;image:url(:/Common/Widgets/CheckBox);}
QCheckBox::indicator:disabled{image:url(:/Common/Widgets/CheckBox_Disabled);}
QCheckBox::indicator:checked{image:url(:/Common/Widgets/CheckBoxChecked);}
QCheckBox::indicator:checked:disabled{image:url(:/Common/Widgets/CheckBoxChecked_Disabled);}
QCheckBox::indicator:indeterminate{image:url(:/Common/Widgets/CheckBoxPartiallyChecked);}
QCheckBox::indicator:indeterminate:disabled{image:url(:/Common/Widgets/CheckBoxPartiallyChecked_Disabled);}
QSlider::groove:horizontal{height:5px;margin:0 3px;padding:0px -9px;border-width:0px 6px;border-image:url(:/Common/Widgets/HSliderGroove) 0 6 repeat repeat;}
QSlider::groove:horizontal:disabled{border-image:url(:/Common/Widgets/HSliderGroove_Disabled) 0 6 repeat repeat;}
QSlider::handle:horizontal{width:11px;margin:-3px 0;image:url(:/Common/Widgets/SliderHandle);}
QSlider::handle:horizontal:pressed{image:url(:/Common/Widgets/SliderHandlePush);}
QSlider::handle:horizontal:disabled{image:url(:/Common/Widgets/SliderHandle_Disabled);}
QSlider::groove:vertical{width:5px;margin:3px 0;padding:-9px 0px;border-width:6px 0px;border-image:url(:/Common/Widgets/VSliderGroove) 6 0 repeat repeat;}
QSlider::groove:vertical:disabled{border-image:url(:/Common/Widgets/VSliderGroove_Disabled) 6 0 repeat repeat;}
QSlider::handle:vertical{height:11px;margin:0 -3px;image:url(:/Common/Widgets/SliderHandle);}
QSlider::handle:vertical:pressed{image:url(:/Common/Widgets/SliderHandlePush);}
QSlider::handle:vertical:disabled{image:url(:/Common/Widgets/SliderHandle_Disabled);}
QScrollBar{margin:0px;padding:0px;border-style:none;background-color:transparent;}
QScrollBar::left-arrow, QScrollBar::right-arrow, QScrollBar::up-arrow, QScrollBar::down-arrow{background-color:transparent;}
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page{background-color:transparent;border-style:none;}
QScrollBar::handle:disabled{background-color:transparent;border-color:transparent;border-image:none;}
QScrollBar:horizontal{min-height:11px;max-height:11px;}
QScrollBar::handle:!disabled:horizontal{background-color:#d46986;border:1px solid COLOR_TINT_GRAY;border-radius:4px;margin:1px 0px 1px 0px;min-width:30px;}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal{width:0px;border:none;}
QScrollBar:vertical{min-width:11px;max-width:11px;}
QScrollBar::handle:!disabled:vertical{background-color:#d46986;border:1px solid COLOR_TINT_GRAY;border-radius:4px;margin:0px 1px 0px 1px;min-height:20px;}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical{height:0px;border-style:none;}
QRadioButton{color:COLOR_DEFAULT;min-height:18px;spacing:10px;font-preset-name:FONT_DEFAULT;}
QRadioButton:disabled{color:COLOR_DEFAULT_DISABLED;}
QRadioButton::indicator{width:15px;height:15px;image:url(:/Common/Widgets/RadioButton);}
QRadioButton::indicator:disabled{image:url(:/Common/Widgets/RadioButton_Disabled);}
QRadioButton::indicator:checked{image:url(:/Common/Widgets/RadioButtonChecked);}
QRadioButton::indicator:checked:disabled{image:url(:/Common/Widgets/RadioButtonChecked_Disabled);}
QPushButton{border:1px solid COLOR_JELLYFISH_GRAY;border-radius:50%;background-color:none;color:COLOR_DEFAULT;font-preset-name:FONT_DEFAULT;padding:0px;}
QPushButton:hover{border-color:COLOR_SQUID_GRAY;color:white;padding:0px;}
QPushButton:pressed{border-color:white;padding:0px;background-color:COLOR_OCTOPUS_GRAY;}
QPushButton:disabled{color:COLOR_DEFAULT_DISABLED;border-color:COLOR_JELLYFISH_GRAY_40;}
QPushButton:default{border-color:COLOR_CORAL_RED;color:COLOR_SQUID_GRAY;}
QPushButton:default:hover{border-color:COLOR_CORAL_RED;color:white;}
UiPlainLineEdit, QLineEdit{border:1px solid COLOR_TINT_GRAY;border-radius:2px;background-color:COLOR_THUNDERSTORM_GRAY;color:COLOR_DEFAULT;min-height:18px;max-height:18px;selection-color:rgb(240, 240, 240);selection-background-color:rgba(255, 255, 255, 50);font-preset-name:FONT_DEFAULT;}
UiPlainLineEdit:!read-only:focus, QLineEdit:!read-only:focus{border-color:COLOR_CORAL_RED;color:white;font-preset-name:FONT_DEFAULT_SEMIBOLD;}
UiPlainLineEdit:disabled, QLineEdit:disabled{border-color:COLOR_TINT_GRAY_40;background-color:COLOR_THUNDERSTORM_GRAY_40;color:COLOR_DEFAULT_DISABLED;}
UiPlainLineEdit:read-only{border-color:COLOR_TINT_GRAY_40;background-color:COLOR_THUNDERSTORM_GRAY_40;color:COLOR_DEFAULT_DISABLED;}
QMenuBar{background-color:#e6ced5;padding-bottom:-1px;border-style:none;border-bottom:1px solid COLOR_TINT_GRAY;}
QMenuBar:active{background-color:#ddb0bc;}
QMenuBar::item{background-color:transparent;padding:-1px 7px;color:COLOR_TINT_GRAY;}
QMenuBar::item:selected, QMenuBar::item:pressed{color:COLOR_TINT_GRAY;background-color:#d46986;}
QMenu{border:1px solid COLOR_TINT_GRAY;border-radius:1px;background-color:COLOR_PENGUIN_GRAY;padding:4px 0px;font-preset-name:FONT_DEFAULT;}
QMenu::item{height:20px;padding:0px 27px 0px 25px;color:COLOR_DEFAULT;min-width:100px;font-preset-name:FONT_DEFAULT;}
QMenu::item:selected{background-color:COLOR_THUNDERSTORM_GRAY;color:white;}
QMenu::item:disabled{background-color:none;color:COLOR_DEFAULT_DISABLED;}
QMenu::separator{height:1px;background:COLOR_JELLYFISH_GRAY;margin:3px 0px;}
QMenu::indicator:checked{image:url(:/Common/Widgets/MenuIndicator);width:10px;height:10px;margin-left:7px;}
QMenu::indicator:checked:selected{image:url(:/Common/Widgets/MenuIndicatorActive);}
QMenu::indicator:checked:disabled{image:url(:/Common/Widgets/MenuIndicator_Disabled);}
QMenu::icon{padding:0 6px;}
QMenu::right-arrow{image:url(:/Common/Widgets/ArrowRight);height:11px;width:11px;padding:0px;margin-right:8px;}
QMenu::right-arrow:disabled{image:url(:/Common/Widgets/ArrowRight_disabled);}
QProgressBar:horizontal{border:1px solid COLOR_NIGHTSKY_GRAY;border-radius:1px;min-height:1px;max-height:1px;background-color:COLOR_NAUTILUS_GRAY;text-align:center;color:transparent;margin:1px;padding:-1px;}
QProgressBar:vertical{border:1px solid COLOR_NIGHTSKY_GRAY;border-radius:1px;min-width:1px;max-width:1px;background-color:COLOR_NAUTILUS_GRAY;text-align:center;color:transparent;margin:1px;padding:-1px;}
QProgressBar::chunk{border-style:none;background-image:none;background-color:COLOR_PARAKEET_GREEN;}
QTextEdit, QPlainTextEdit, QTextBrowser{border:1px solid COLOR_LICORICE_GRAY;border-radius:2px;background-color:COLOR_THUNDERSTORM_GRAY;color:COLOR_SMOKE_GRAY;min-height:20px;selection-color:rgb(240, 240, 240);selection-background-color:rgba(255, 255, 255, 50);}
QTextEdit:!read-only:focus, QPlainTextEdit:!read-only:focus{border-color:COLOR_CORAL_RED;color:white;font-preset-name:FONT_DEFAULT_SEMIBOLD;}
QTextBrowser:!read-only:focus, QTextBrowser:focus{border-color:COLOR_LICORICE_GRAY;}
QTextEdit:disabled, QPlainTextEdit:disabled{border-color:COLOR_TINT_GRAY_40;background-color:COLOR_THUNDERSTORM_GRAY_40;color:COLOR_DEFAULT_DISABLED;}
QTreeWidget, QTreeView{background-color:COLOR_PENGUIN_GRAY;alternate-background-color:COLOR_JAGUAR_GRAY;selection-background-color:COLOR_OCTOPUS_GRAY;show-decoration-selected:1;}
QTreeWidget::item, QTreeView::item{color:COLOR_DEFAULT;border-style:none;padding:0px 4px;min-height:23px;max-height:23px;font-preset-name:FONT_DEFAULT;}
QTreeWidget::item:hover, QTreeView::item:hover{color:white;}
QTreeWidget::item:selected, QTreeView::item:selected{color:white;background-color:COLOR_OCTOPUS_GRAY;}
QTreeWidget::item:disabled, QTreeView::item:disabled{color:COLOR_DEFAULT_DISABLED;}
QTreeWidget::item:selected:disabled, QTreeView::item:selected:disabled{color:rgba(255, 255, 255, 102);}
QTreeWidget::branch:has-siblings:!adjoins-item, QTreeWidget::branch:has-siblings:adjoins-item, QTreeWidget::branch:!has-children:!has-siblings:adjoins-item, QTreeView::branch:has-siblings:!adjoins-item, QTreeView::branch:has-siblings:adjoins-item, QTreeView::branch:!has-children:!has-siblings:adjoins-item{image:none;}
QTreeWidget::branch:has-children:!has-siblings:closed, QTreeWidget::branch:closed:has-children:has-siblings, QTreeView::branch:has-children:!has-siblings:closed, QTreeView::branch:closed:has-children:has-siblings{image:url(:/Common/Widgets/ArrowRight);}
QTreeWidget::branch:open:has-children:!has-siblings, QTreeWidget::branch:open:has-children:has-siblings, QTreeView::branch:open:has-children:!has-siblings, QTreeView::branch:open:has-children:has-siblings{image:url(:/Common/Widgets/Arrow);}
QHeaderView::section{background-color:COLOR_ORCA_GRAY;border-style:none;border-bottom:1px solid COLOR_TINT_GRAY;border-right:1px solid qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0 COLOR_JELLYFISH_GRAY, stop:0.94 COLOR_JELLYFISH_GRAY, stop:0.941 rgba(0, 0, 0, 0), stop:1 rgba(0, 0, 0, 0));min-height:19px;max-height:19px;color:COLOR_DEFAULT;font-preset-name:FONT_PSYLOCKE;padding:0px 6px;}
QHeaderView[SkinSizeMode="Small"]::section{min-height:17px;max-height:17px;font-preset-name:FONT_PUNISHER;}
QHeaderView::section:disabled{color:COLOR_DEFAULT_DISABLED;}
QHeaderView::section:last{border-right-style:none;}
QHeaderView::section:checked{color:white;font-preset-name:FONT_PSYLOCKE_SEMIBOLD;}
QHeaderView::section:checked:disabled{color:rgba(255, 255, 255, 102);}
QHeaderView::section:first{padding-left:10px;}
QHeaderView::down-arrow, QHeaderView::up-arrow{subcontrol-origin:content;subcontrol-position:center right;position:relative;width:11px;height:11px;right:4px;}
QHeaderView::down-arrow{image:url(:/Common/Widgets/SpinBoxArrowDown);}
QHeaderView::up-arrow{image:url(:/Common/Widgets/SpinBoxArrowUp);}
QHeaderView::down-arrow:disabled{image:url(:/Common/Widgets/SpinBoxArrowDown_disabled);}
QHeaderView::up-arrow:disabled{image:url(:/Common/Widgets/SpinBoxArrowUp_disabled);}
QToolTip{border:1px solid black;background-color:#e6ced5;color:COLOR_TINT_GRAY;padding:2px;}
QListWidget{border-style:none;background-color:COLOR_POSEIDON_GRAY;selection-background-color:COLOR_OCTOPUS_GRAY;}
QListWidget::item{height:23px;margin:0px;border-style:none;padding-left:8px;color:COLOR_SMOKE_GRAY;}
QListWidget::item:hover{color:white;}
QListWidget::item:selected{color:white;background-color:COLOR_OCTOPUS_GRAY;}
QDateEdit::drop-down{subcontrol-origin:padding;subcontrol-position:center right;margin:0px 9px 0px 3px;image:url(:/Common/Widgets/Arrow);image-position:center center;width:11px;height:11px;}