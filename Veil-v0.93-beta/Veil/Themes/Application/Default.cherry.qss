QTimeEdit:!read-only:focus{border-color:COLOR_CORAL_RED;color:white;}
QTimeEdit:disabled{border-color:COLOR_TINT_GRAY_40;color:COLOR_SQUID_GRAY_40;background-color:COLOR_THUNDERSTORM_GRAY_40;}
