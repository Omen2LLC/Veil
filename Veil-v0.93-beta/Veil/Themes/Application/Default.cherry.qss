QComboBox{border:1px solid COLOR_LICORICE_GRAY;border-radius:2px;background-color:COLOR_THUNDERSTORM_GRAY;min-height:18px;max-height:18px;color:COLOR_DEFAULT;selection-color:rgb(240, 240, 240);selection-background-color:rgba(255, 255, 255, 50);padding:0px 0px 0px 10px;font-preset-name:FONT_DEFAULT;}
QComboBox:disabled{border-color:COLOR_LICORICE_GRAY_40;background-color:COLOR_THUNDERSTORM_GRAY_40;color:COLOR_DEFAULT_DISABLED;}
QComboBox:on, QComboBox:editable:focus{color:white;}
QComboBox::drop-down{subcontrol-origin:padding;subcontrol-position:center right;margin:0px 9px 0px 3px;image:url(:/Common/Widgets/Arrow);width:11px;height:11px;}
QComboBox::drop-down:hover{image:url(:/Common/Widgets/Arrow_hover);}
QComboBox::drop-down:on{image:url(:/Common/Widgets/Arrow_push);}
QComboBox::drop-down:disabled{image:url(:/Common/Widgets/Arrow_disabled);}
QComboBoxDropDownItemView{border:1px solid COLOR_TINT_GRAY;border-radius:2px;background-color:COLOR_PENGUIN_GRAY;color:COLOR_DEFAULT;selection-background-color:COLOR_THUNDERSTORM_GRAY;padding:5px 0px;}
QComboBoxDropDownItemView::corner{background-color:transparent;}
QComboBoxDropDownItemView::item{height:22px;color:COLOR_DEFAULT;padding-left:7px;}
QComboBoxDropDownItemView::item:selected{color:white;}
QComboBoxDropDownItemView::item:disabled{color:COLOR_DEFAULT_DISABLED;}
QSpinBox{color:COLOR_DEFAULT;border:1px solid COLOR_TINT_GRAY;border-radius:2px;background-color:COLOR_THUNDERSTORM_GRAY;padding:-1px 19px -1px 9px;margin:0px;min-height:18px;selection-color:rgb(240, 240, 240);selection-background-color:rgba(255, 255, 255, 50);}
QSpinBox:!read-only:focus{border-color:COLOR_CORAL_RED;color:white;}
QSpinBox:disabled{border-color:COLOR_TINT_GRAY_40;color:COLOR_SQUID_GRAY_40;background-color:COLOR_THUNDERSTORM_GRAY_40;}
QSpinBox::up-button{subcontrol-origin:border;width:11px;height:8px;right:8px;subcontrol-position:top right;image:url(:/Common/Widgets/SpinBoxArrowUp);top:1px;}
QSpinBox::up-button:hover{image:url(:/Common/Widgets/SpinBoxArrowUp_hover);}
QSpinBox::up-button:pressed{image:url(:/Common/Widgets/SpinBoxArrowUp_push);}
QSpinBox::up-button:disabled{image:url(:/Common/Widgets/SpinBoxArrowUp_disabled);}
QSpinBox::down-button{subcontrol-origin:border;width:11px;height:8px;right:8px;subcontrol-position:bottom right;image:url(:/Common/Widgets/SpinBoxArrowDown);bottom:1px;}
QSpinBox::down-button:hover{image:url(:/Common/Widgets/SpinBoxArrowDown_hover);}
QSpinBox::down-button:pressed{image:url(:/Common/Widgets/SpinBoxArrowDown_push);}
QSpinBox::down-button:disabled{image:url(:/Common/Widgets/SpinBoxArrowDown_disabled);}
QDoubleSpinBox{color:COLOR_DEFAULT;border:1px solid COLOR_TINT_GRAY;border-radius:2px;background-color:COLOR_THUNDERSTORM_GRAY;padding:-1px 19px -1px 9px;margin:0px;min-height:18px;selection-color:rgb(240, 240, 240);selection-background-color:rgba(255, 255, 255, 50);}
QDoubleSpinBox:!read-only:focus{border-color:COLOR_CORAL_RED;color:white;}
QDoubleSpinBox:disabled{border-color:COLOR_TINT_GRAY_40;color:COLOR_SQUID_GRAY_40;background-color:COLOR_THUNDERSTORM_GRAY_40;}
QDoubleSpinBox::up-button{subcontrol-origin:border;width:11px;height:8px;right:8px;subcontrol-position:top right;image:url(:/Common/Widgets/SpinBoxArrowUp);top:3px;}
QDoubleSpinBox::up-button:hover{image:url(:/Common/Widgets/SpinBoxArrowUp_hover);}
QDoubleSpinBox::up-button:pressed{image:url(:/Common/Widgets/SpinBoxArrowUp_push);}
QDoubleSpinBox::up-button:disabled{image:url(:/Common/Widgets/SpinBoxArrowUp_disabled);}
QDoubleSpinBox::down-button{subcontrol-origin:border;width:11px;height:8px;right:8px;subcontrol-position:bottom right;image:url(:/Common/Widgets/SpinBoxArrowDown);bottom:3px;}
QDoubleSpinBox::down-button:hover{image:url(:/Common/Widgets/SpinBoxArrowDown_hover);}
QDoubleSpinBox::down-button:pressed{image:url(:/Common/Widgets/SpinBoxArrowDown_push);}
QDoubleSpinBox::down-button:disabled{image:url(:/Common/Widgets/SpinBoxArrowDown_disabled);}
