UiQDeliverPanelRenderSettingsFrame, UiQDeliverPanelDeckSettingsFrame{background-color:#E6CED5;}
UiQDeliverPanelTapeSettingsBottomFrame{border-style:none;border-top:1px solid COLOR_TINT_GRAY;background-color:#E6CED5;}
UiQPageTopBarDropDownMenuButton[SkinId="DeliverPanelTLClipFilter"]:disabled{image:none;}
UiDeliverPanelRenderSettingsWidget{background-color:#E6CED5;}
UiQDeliverPanelRenderSettingsAdditionalOutputContainer{min-height:33px;max-height:33px;border-style:none;border-bottom:1px solid COLOR_TINT_GRAY;padding-bottom:-1px;}
UiQDeliverPanelRenderSettingsTargetFileDetailsFrame{max-height:148px;border-style:none;border-bottom:1px solid COLOR_TINT_GRAY;background-color:#E6CED5;padding-top:10px;padding-bottom:13px;}
UiQSmallTextButton[SkinId="DeliverPanelRenderSettingsBrowse"]{min-width:68px;max-width:68px;min-height:22px;max-height:22px;padding:-1px 0px;}
QTextEdit[SkinId="DeliverPanelRenderSettingsTextEdit"]{min-height:18px;max-height:18px;padding-top:2px;padding-left:2px;}
UiQDeliverPanelRenderSettingsTargetFileTextEdit{color:COLOR_SMOKE_GRAY;min-height:20px;max-height:20px;padding-top:0px;padding-left:2px;border:1px solid COLOR_LICORICE_GRAY;border-radius:2px;background-color:COLOR_THUNDERSTORM_GRAY;selection-color:rgb(240, 240, 240);selection-background-color:rgba(255, 255, 255, 50);}
UiQDeliverPanelRenderSettingsTargetFileTextEdit:read-only{border:1px solid transparent;background-color:COLOR_POSEIDON_GRAY;}
UiQDeliverPanelRenderSettingsTargetFileTextEdit:!read-only:focus{border-color:COLOR_CORAL_RED;background-color:COLOR_THUNDERSTORM_GRAY;}
UiQMoreOptionsTextButton[SkinId="DeliverPanelRenderSettingsMoreOptions"]{padding:0px 10px 0px 17px;}
UiQDeliverPanelRenderSettingsRenderTypeContainer{border-style:none;border-bottom:1px solid COLOR_TINT_GRAY;padding:8px 0px 4px;min-height:32px;max-height:32px;}
UiQDeliverPanelRenderSettingsRenderSpeedContainer{border-style:none;min-height:44px;max-height:44px;border-top:1px solid COLOR_TINT_GRAY;border-bottom:1px solid COLOR_TINT_GRAY;}
UiQDeliverPanelRenderSettingsRenderSpeedContainer[SkinId="TopBorderOnly"]{border-bottom-color:transparent;}
UiQTextButton[SkinId="AddToRenderQueue"]{margin-left:10px;}
UiQDeliverPanelRenderSettingsOutputWidgetsTabBar{min-height:33px;max-height:33px;}
UiQDeliverPanelRenderSettingsOutputWidgetsTabBar::tab{background-color:transparent;border-style:none;border-bottom:1px solid COLOR_TINT_GRAY;height:32px;width:28px;padding:0px;border-image:none;}
UiQDeliverPanelRenderSettingsOutputWidgetsTabBar::tab:hover{color:white;border-bottom:1px solid white;}
UiQDeliverPanelRenderSettingsOutputWidgetsTabBar::tab:selected{color:white;border-bottom:1px solid COLOR_CORAL_RED;}
UiQDeliverPanelRenderSettingsOutputWidgetsTabBar::tear{background-color:transparent;border-style:none;}
UiQDeliverPanelRenderSettingsOutputWidgetsTabBar::scroller{width:40px;}
UiQDeliverPanelRenderSettingsOutputWidgetsTabBarArrowButton{background-color:COLOR_POSEIDON_GRAY;border-style:none;border-bottom:1px solid COLOR_TINT_GRAY;padding:0px;margin:0px;min-width:20px;max-width:20px;}
UiQDeliverPanelRenderSettingsOutputWidgetsTabBarArrowButton::right-arrow{image:url(:/Common/Widgets/ArrowRight);}
UiQDeliverPanelRenderSettingsOutputWidgetsTabBarArrowButton::right-arrow:hover{image:url(:/Common/Widgets/ArrowRight_hover);}
UiQDeliverPanelRenderSettingsOutputWidgetsTabBarArrowButton::right-arrow:pressed{image:url(:/Common/Widgets/ArrowRight_push);}
UiQDeliverPanelRenderSettingsOutputWidgetsTabBarArrowButton::right-arrow:disabled{image:url(:/Common/Widgets/ArrowRight_disabled);}
UiQDeliverPanelRenderSettingsOutputWidgetsTabBarArrowButton::left-arrow{image:url(:/Common/Widgets/ArrowLeft);}
UiQDeliverPanelRenderSettingsOutputWidgetsTabBarArrowButton::left-arrow:hover{image:url(:/Common/Widgets/ArrowLeft_hover);}
UiQDeliverPanelRenderSettingsOutputWidgetsTabBarArrowButton::left-arrow:pressed{image:url(:/Common/Widgets/ArrowLeft_active);}
UiQDeliverPanelRenderSettingsOutputWidgetsTabBarArrowButton::left-arrow:disabled{image:url(:/Common/Widgets/ArrowLeft_disabled);}
UiQDeliverPanelRenderSettingsPresetsContainer{min-height:67px;max-height:67px;padding:0px;margin:0px;border-bottom:1px solid COLOR_LICORICE_GRAY;background-color:COLOR_ORCA_GRAY;}
UiQSectionHeaderArrowButton[SkinId="PresetMenu"]{min-height:23px;max-height:23px;margin-top:11px;margin-bottom:11px;}
UiQPresetNameHiddenStyleButton{min-height:11px;max-height:11px;border-style:none;padding:0px;font-preset-name:FONT_PSYLOCKE;}
UiQPresetNameHiddenStyleButton:hover, UiQPresetNameHiddenStyleButton:checked{color:white;}
UiQInformationButton{border-style:none;background-color:transparent;image-position:center center;min-height:20px;max-height:20px;min-width:20px;max-width:20px;image:url(:/Common/Headers/Info);}
UiQTextDropDownButton[SkinId="DeliverPanelRenderSettingsPresetComboBox"]{border:1px solid COLOR_LICORICE_GRAY;border-radius:5px;background-color:COLOR_THUNDERSTORM_GRAY;min-height:36px;max-height:36px;min-width:246px;max-width:246px;padding-left:5px;qproperty-iconSize:46px 30px;text-align:left;font-preset-name:FONT_MAGNETO_SEMIBOLD;}
UiQTextDropDownButton[SkinId="DeliverPanelRenderSettingsPresetComboBox"]::menu-indicator{subcontrol-origin:content;subcontrol-position:right center;margin:0px 0px 0px 0px;image:url(:/Common/Widgets/Arrow);image-position:center center;border:none;width:35px;height:35px;border-image:none;border-width:0px;padding:0px;}
UiQTextDropDownButton[SkinId="DeliverPanelRenderSettingsPresetComboBox"]::menu-indicator:disabled{image:url(:/Common/Widgets/Arrow_disabled);}
QMenu[SkinId="DeliverPanelRenderSettingsPresetComboBoxMenu"]{border-radius:5px;padding:4px 0px 4px 0px;}
QFrame[SkinId="RenderSettingsPresetMenuGroupSeparator"]{min-height:1px;max-height:1px;margin:2px 0px 2px 0px;}
QLabel[SkinId="RenderSettingsPresetMenuGroupSeparatorLine"]{background-color:COLOR_JELLYFISH_GRAY;}
UiQDeliverPanelRenderQueueBottomBarFrame{background-color:#E6CED5;border-style:none;border-top:1px solid COLOR_TINT_GRAY;}
UiQDeliverPanelRenderQueueRenderProgressLabel{color:COLOR_CLAM_GRAY;}
UiQDeliverPanelRenderQueueRenderOverallJobIndex, UiQDeliverPanelRenderQueueRenderOverallTimeRemaining{color:COLOR_FOGGY_GRAY;}
UiQDeliverPanelRenderQueueRemoteRenderLabel{color:white;border-style:none;border-radius:4px;background-color:COLOR_CORAL_RED;padding:-1px 24px;min-height:26px;max-height:26px;font-preset-name:FONT_PSYLOCKE;}
UiQDeliverPanelTimelineToolbarTopFrame{border-style:none;border-bottom:1px solid COLOR_TINT_GRAY;background-color:COLOR_ORCA_GRAY;padding:1px 0px 5px 8px;min-height:30px;max-height:30px;}
UiQDeliverPanelTimelineTopSeparatorBuddy{border-style:none;border-top:1px solid COLOR_TINT_GRAY;background-color:COLOR_ORCA_GRAY;min-height:4px;max-height:4px;}
UiQDeliverPanelTimelineTopSeparatorBuddy:disabled{border-top-color:transparent;}
UiVideoAudioSettingsWidget{background-color:#E6CED5;}
UiQDeliverVTRFileBrowserDialogBottomFrame{min-height:60px;max-height:60px;padding:0px 20px;border-style:none;border-top:1px solid COLOR_TINT_GRAY;}
UiQDeliverCustomPresetSelectionContainer{border:1px solid COLOR_TINT_GRAY;border-radius:8px;background-color:COLOR_ORCA_GRAY;}
QMenu[SkinId="DeliverPresetItemMenu"]{max-width:450px;}
QLabel[SkinId="UiQDeliverPanelRenderSettingsFileSizeLabel"]{font-preset-name:FONT_ICEMAN;color:white;}