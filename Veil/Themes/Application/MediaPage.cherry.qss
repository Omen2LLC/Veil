UiQMediaPageAudioWidgetsFrame{background-color:COLOR_POSEIDON_GRAY;}
QLabel[SkinId="MediaPoolViewsSortMenuSortMediaByLabel"]{min-height:30px;max-height:30px;color:white;padding-left:27px;font-preset-name:FONT_DEFAULT;}
UiQMediaPoolClipViewContainer{background-color:#E6CED5;}
UiQFilmstripClipInfoOuterContainer{background-color:COLOR_PENGUIN_GRAY;border:none;border-bottom:1px solid rgb(10, 10, 10);}
UiQFilmstripClipInfoInnerContainer{border:none;border-bottom:1px solid rgb(10, 10, 10);margin:14px 0px 2px 0px;padding:0px 11px;}
UiQFilmstripClipInfoThumbnailsFrame{border:1px solid black;}
UiQFilmstripClipInfoFrame{min-height:23px;max-height:23px;border:none;border-top:1px solid rgb(52, 52, 52);}
QLabel[SkinId="FilmstripClipInfoDuration"]{font-preset-name:FONT_PSYLOCKE;color:COLOR_SMOKE_GRAY;min-width:60px;max-width:60px;}
QLabel[SkinId="FilmstripClipInfoNameLabel"]{font-preset-name:FONT_PSYLOCKE;color:white;}
UiQCloneToolEmptyStackedWidget{background-color:#E6CED5;}
UiQCloneToolProgressFrame{background-color:#E6CED5;}
UiQCloneToolWidgetBottomBarFrame{border-style:none;border-top:1px solid COLOR_TINT_GRAY;background-color:#E6CED5;}
UiQCintelScannerControlPanelCalibrationDividerFrame{min-height:2px;max-height:2px;background-color:rgb(59, 61, 71);}
UiQVTRCintelScannerControlVTRCaptureInfoDividerFrame{background-color:rgb(59, 61, 71);}
UiQCintelThumbWheelNotchLabel{image:url(:/Media/Cintel/LightShuttle_Notch);min-width:3px;max-width:3px;min-height:148px;max-height:148px;}
UiQCintelParamLabel{color:rgb(166, 166, 166);}
UiQCintelParamLabel:disabled{color:rgba(166, 166, 166, 128);}
UiQCintelDirectionButton, UiQCintelGrabFrameButton, UiQCintelLightSourceButton, UiQCintelMoveButton{image-position:center center;background-image:none;background-color:transparent;padding:0px;margin:0px;border-style:none;border-image:none;}
UiQCintelDirectionButton, UiQCintelGrabFrameButton{min-width:30px;max-width:30px;min-height:30px;max-height:30px;}
UiQCintelLightSourceButton{min-width:23px;max-width:23px;min-height:17px;max-height:17px;}
UiQCintelMoveButton{min-width:22px;max-width:22px;min-height:22px;max-height:22px;}
UiQCintelDirectionButton:pressed, UiQCintelGrabFrameButton:pressed, UiQCintelLightSourceButton:pressed, UiQCintelMoveButton:pressed{background-image:none;background-color:transparent;padding:0px;margin:0px;border:none;border-image:none;}
UiQCintelDirectionButton:checked, UiQCintelGrabFrameButton:checked, UiQCintelLightSourceButton:checked, UiQCintelMoveButton:checked{background-image:none;background-color:transparent;padding:0px;margin:0px;border:none;border-image:none;}
UiQCintelMoveButton[SkinId="PerfMoveReverse"]{image:url(:/Media/Cintel/Minus);}
UiQCintelMoveButton[SkinId="PerfMoveReverse"]:pressed, UiQCintelMoveButton[SkinId="PerfMoveReverse"]:hover{image:url(:/Media/Cintel/Minus_On);}
UiQCintelMoveButton[SkinId="PerfMoveForward"]{image:url(:/Media/Cintel/Plus);}
UiQCintelMoveButton[SkinId="PerfMoveForward"]:pressed, UiQCintelMoveButton[SkinId="PerfMoveForward"]:hover{image:url(:/Media/Cintel/Plus_On);}
UiQCintelMoveButton[SkinId="FrameMoveReverse"]{image:url(:/Media/Cintel/Minus);}
UiQCintelMoveButton[SkinId="FrameMoveReverse"]:pressed, UiQCintelMoveButton[SkinId="FrameMoveReverse"]:hover{image:url(:/Media/Cintel/Minus_On);}
UiQCintelMoveButton[SkinId="FrameMoveForward"]{image:url(:/Media/Cintel/Plus);}
UiQCintelMoveButton[SkinId="FrameMoveForward"]:pressed, UiQCintelMoveButton[SkinId="FrameMoveForward"]:hover{image:url(:/Media/Cintel/Plus_On);}
UiQCintelDirectionButton[SkinId="DirectionA"]{image:url(:/Media/Cintel/DirectionA);}
UiQCintelDirectionButton[SkinId="DirectionA"]:pressed, UiQCintelDirectionButton[SkinId="DirectionA"]:hover, UiQCintelDirectionButton[SkinId="DirectionA"]:checked{image:url(:/Media/Cintel/DirectionA_On);}
UiQCintelDirectionButton[SkinId="DirectionB"]{image:url(:/Media/Cintel/DirectionB);}
UiQCintelDirectionButton[SkinId="DirectionB"]:pressed, UiQCintelDirectionButton[SkinId="DirectionB"]:hover, UiQCintelDirectionButton[SkinId="DirectionB"]:checked{image:url(:/Media/Cintel/DirectionB_On);}
UiQCintelLightSourceButton[SkinId="LightMin"]{image:url(:/Media/Cintel/Light_Min);}
UiQCintelLightSourceButton[SkinId="LightMax"]{image:url(:/Media/Cintel/Light_Max);}
UiQCintelGrabFrameButton{image:url(:/Media/Cintel/Camera);}
UiQCintelGrabFrameButton:hover{image:url(:/Media/Cintel/Camera_hover);}
UiQCintelGrabFrameButton:pressed{image:url(:/Media/Cintel/Camera_push);}
UiQMediaPageVTRCaptureWidgetFrame{background-color:COLOR_PENGUIN_GRAY;}
UiQTextButton[SkinId="VTRIngestPanelTextButton"]{padding:-1px 20px;}
UiQTextButton[SkinId="VTRCaptureControl"]{padding-left:10px;padding-right:10px;}
UiQVTRIngestDeviceMessageLabel{color:COLOR_JELLYFISH_GRAY;font-preset-name:FONT_SENTINAL_LIGHT;}
UiQVTRIngestConnectionMessageLabel{color:COLOR_JELLYFISH_GRAY;font-preset-name:FONT_BANSHEE_LIGHT;}
UiQMediaPoolSearchRow{border-style:none;border-bottom:1px solid COLOR_TINT_GRAY;background-color:COLOR_ORCA_GRAY;}
UiQMediaPoolSearchRow[SkinId="ControlsRow"]{min-height:29px;max-height:29px;}
UiQMediaPoolSearchRow[SkinId="PeoplesRow"]{min-height:50px;max-height:50px;}
UiQMediaPoolSearchField{border:1px solid COLOR_TINT_GRAY;min-height:21px;max-height:21px;border-radius:2px;}
UiQMediaPoolSearchField[SkinId="Active"]{border-color:COLOR_CORAL_RED;}
QTextEdit[SkinId="MediaPoolAISearch"]{border:none;border-radius:0px;border-left:1px solid COLOR_TINT_GRAY;min-height:21px;max-height:21px;padding:0px 8px;}
QTextEdit[SkinId="MediaPoolAIMetadataOnlySearch"]{border:none;border-radius:0px;min-height:21px;max-height:21px;padding:0px 8px;}
UiQLineEditWithClearButton[SkinId="MediaPoolPhotoEffectsSearch"]{min-height:19px;max-height:19px;}
UiQMediaPoolAISearchOptionButton{border:none;background-color:COLOR_THUNDERSTORM_GRAY;image-position:left center;margin:0px;padding:0px 8px;min-width:44px;max-width:44px;min-height:21px;max-height:21px;}
UiQMediaPoolAISearchOptionButton::menu-button{width:11px;border:none;margin:0px;padding:0px;}
UiQMediaPoolAISearchOptionButton::menu-indicator{subcontrol-origin:content;subcontrol-position:right center;margin:0px 2px 0px 0px;padding:0px;width:11px;height:21px;image:url(:/Common/Widgets/Arrow);}
UiQMediaPoolAISearchOptionButton::menu-arrow{image:url(:/Common/Widgets/Arrow);}
UiQMediaPoolAISearchOptionButton::menu-indicator:hover, UiQMediaPoolAISearchOptionButton::menu-arrow:hover{image:url(:/Common/Widgets/Arrow_hover);}
UiQMediaPoolAISearchOptionButton::menu-indicator:pressed{image:url(:/Common/Widgets/Arrow_pressed);}
UiQMediaPoolAISearchOptionButton::menu-indicator:disabled{image:url(:/Common/Widgets/Arrow_disabled);}
UiQMediaPoolAISearchOptionButton:disabled{color:COLOR_DEFAULT_DISABLED;}
UiQMediaPoolAISearchOptionButton[SkinId="SearchAll"]{image:url(:/Media/AISearch/SearchAll);}
UiQMediaPoolAISearchOptionButton[SkinId="SearchAll"]:hover{image:url(:/Media/AISearch/SearchAll_hover);}
UiQMediaPoolAISearchOptionButton[SkinId="SearchAll"]:pressed{image:url(:/Media/AISearch/SearchAll_push);}
UiQMediaPoolAISearchOptionButton[SkinId="SearchVisualOnly"]{image:url(:/Media/AISearch/SearchVisualOnly);}
UiQMediaPoolAISearchOptionButton[SkinId="SearchVisualOnly"]:hover{image:url(:/Media/AISearch/SearchVisualOnly_hover);}
UiQMediaPoolAISearchOptionButton[SkinId="SearchVisualOnly"]:pressed{image:url(:/Media/AISearch/SearchVisualOnly_push);}
UiQMediaPoolAISearchOptionButton[SkinId="SearchTranscriptOnly"]{image:url(:/Media/AISearch/SearchTranscriptOnly);}
UiQMediaPoolAISearchOptionButton[SkinId="SearchTranscriptOnly"]:hover{image:url(:/Media/AISearch/SearchTranscriptOnly_hover);}
UiQMediaPoolAISearchOptionButton[SkinId="SearchTranscriptOnly"]:pressed{image:url(:/Media/AISearch/SearchTranscriptOnly_push);}
UiQMediaPoolAISearchOptionButton[SkinId="SearchMetadataOnly"]{image:url(:/Media/AISearch/SearchMetadataOnly);}
UiQMediaPoolAISearchOptionButton[SkinId="SearchMetadataOnly"]:hover{image:url(:/Media/AISearch/SearchMetadataOnly_hover);}
UiQMediaPoolAISearchOptionButton[SkinId="SearchMetadataOnly"]:pressed{image:url(:/Media/AISearch/SearchMetadataOnly_push);}
UiQSectionHeaderIconButton[SkinId="MediaPoolSearchSmartBin"]{image:url(:/Media/AISearch/AddAsSmartBin);}
UiQSectionHeaderIconButton[SkinId="MediaPoolSearchSmartBin"]:hover{image:url(:/Media/AISearch/AddAsSmartBin_hover);}
UiQSectionHeaderIconButton[SkinId="MediaPoolSearchSmartBin"]:pressed{image:url(:/Media/AISearch/AddAsSmartBin_push);}
UiQSectionHeaderIconButton[SkinId="MediaPoolSearchSmartBin"]:disabled{image:url(:/Media/AISearch/AddAsSmartBin_disabled);}
UiQSectionHeaderIconButton[SkinId="MediaPoolSearchPeople"]{image:url(:/Common/Headers/MultiUserCollab);}
UiQSectionHeaderIconButton[SkinId="MediaPoolSearchPeople"]:hover{image:url(:/Common/Headers/MultiUserCollab_hover);}
UiQSectionHeaderIconButton[SkinId="MediaPoolSearchPeople"]:pressed, UiQSectionHeaderIconButton[SkinId="MediaPoolSearchPeople"]:checked{image:url(:/Common/Headers/MultiUserCollab_push);}
UiQSectionHeaderIconButton[SkinId="MediaPoolSearchPeople"]:disabled{image:url(:/Common/Headers/MultiUserCollab_disabled);}
UiQSectionHeaderIconButton[SkinId="MediaPoolSearchPeopleSettings"]{image:url(:/Common/Headers/Settings);}
UiQSectionHeaderIconButton[SkinId="MediaPoolSearchPeopleSettings"]:hover{image:url(:/Common/Headers/Settings_hover);}
UiQSectionHeaderIconButton[SkinId="MediaPoolSearchPeopleSettings"]:pressed{image:url(:/Common/Headers/Settings_push);}
UiQGroupLeftButton[SkinId="MediaPoolSearchLeftButton"], UiQGroupRightButton[SkinId="MediaPoolSearchRightButton"]{padding:0px 0px;min-width:90px;min-height:18px;max-height:18px;}
UiQMediaPoolClipViewContainer UiQCintelParamLabel:enabled, UiQMediaPoolClipViewContainer UiQVTRIngestDeviceMessageLabel:enabled, UiQMediaPoolClipViewContainer UiQVTRIngestConnectionMessageLabel:enabled, UiQCloneToolEmptyStackedWidget UiQCintelParamLabel:enabled, UiQCloneToolEmptyStackedWidget UiQVTRIngestDeviceMessageLabel:enabled, UiQCloneToolEmptyStackedWidget UiQVTRIngestConnectionMessageLabel:enabled, UiQCloneToolProgressFrame UiQCintelParamLabel:enabled, UiQCloneToolProgressFrame UiQVTRIngestDeviceMessageLabel:enabled, UiQCloneToolProgressFrame UiQVTRIngestConnectionMessageLabel:enabled, UiQCloneToolWidgetBottomBarFrame UiQCintelParamLabel:enabled, UiQCloneToolWidgetBottomBarFrame UiQVTRIngestDeviceMessageLabel:enabled, UiQCloneToolWidgetBottomBarFrame UiQVTRIngestConnectionMessageLabel:enabled{color:COLOR_TINT_GRAY;}