UiQBgTaskNameLabel{font-preset-name:FONT_MAGNETO_SEMIBOLD;color:white;}
UiQBgTaskErrorTitle{font-preset-name:FONT_PSYLOCKE_SEMIBOLD;color:COLOR_CORAL_RED;}
UiQBgTaskErrorDescription{font-preset-name:FONT_PSYLOCKE;color:COLOR_SMOKE_GRAY;}
