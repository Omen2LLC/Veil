UiColorCanvasDropDownButton{border-style:none;background-color:transparent;image-position:left center;min-width:37px;max-width:37px;min-height:20px;max-height:20px;margin:1px 0px 0px 0px;}
UiColorCanvasDropDownButton::menu-indicator{subcontrol-origin:content;subcontrol-position:right center;margin:-1px 0px 0px 0px;image:url(:/Common/Widgets/Arrow);}
UiColorCanvasDropDownButton::menu-indicator:hover{image:url(:/Common/Widgets/Arrow_hover);}
UiColorCanvasDropDownButton::menu-indicator:pressed{image:url(:/Common/Widgets/Arrow_push);}
UiColorCanvasDropDownButton::menu-indicator:disabled{image:url(:/Common/Widgets/Arrow_disabled);}
UiColorCanvasDropDownButton[SkinId="CursorSelected"]{image:url(:/Common/Headers/Cursor);}
UiColorCanvasDropDownButton[SkinId="HandToolSelected"]{image:url(:/Common/Headers/HandTool);}
UiColorCanvasDropDownButton[SkinId="GraphViewSelected"]{image:url(:/Common/Headers/Nodes);}
UiColorCanvasDropDownButton[SkinId="ListViewSelected"]{image:url(:/Common/Headers/Layers);}
QMenu[SkinId="UiColorCanvasDropDownMenu"]{min-width:140px;max-width:140px;}
QMenu[SkinId="UiColorCanvasDropDownMenu"]::item{min-width:140px;max-width:140px;min-height:25px;max-height:25px;padding-left:25px;}