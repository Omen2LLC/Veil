UiQMediaMetadataTitleLabel, UiQMediaMetadataDurationLabel{color:white;font-preset-name:FONT_MAGNETO;}
UiQMediaMetadataDurationLabel{min-width:90px;max-width:90px;}
UiQMediaMetadataDurationLabel[SkinSizeMode="Small"]{min-width:82px;max-width:82px;}
UiQMediaMetadataDirectoryLabel{min-height:15px;max-height:15px;color:COLOR_SMOKE_GRAY;font-preset-name:FONT_PSYLOCKE;}
UiQMediaMetadataCodecLabel, UiQMediaMetadataAudioCodecLabel, UiQMediaMetadataFrameRateLabel, UiQMediaMetadataFrequencyLabel, UiQMediaMetadataResolutionLabel, UiQMediaMetadataAudioChannelsLabel{color:white;}
UiQMediaMetadataCodecLabel:disabled, UiQMediaMetadataAudioCodecLabel:disabled{color:rgb(83, 83, 87);}
UiQMediaMetadataResolutionContainer, UiQMediaMetadataAudioChannelsContainer{min-width:90px;max-width:90px;}
UiQMediaMetadataResolutionContainer[SkinSizeMode="Large"], UiQMediaMetadataAudioChannelsContainer[SkinSizeMode="Large"], UiQMediaMetadataResolutionContainer[SkinSizeMode="Medium"], UiQMediaMetadataAudioChannelsContainer[SkinSizeMode="Medium"]{min-width:90px;max-width:90px;}
UiQMediaMetadataResolutionContainer[SkinSizeMode="Small"], UiQMediaMetadataAudioChannelsContainer[SkinSizeMode="Small"]{min-width:82px;max-width:82px;}
UiQMediaMetadataFrequencyContainer, UiQMediaMetadataFrameRateContainer{min-width:108px;max-width:108px;}
UiQMediaMetadataFrequencyContainer[SkinSizeMode="Large"], UiQMediaMetadataFrameRateContainer[SkinSizeMode="Large"], UiQMediaMetadataFrequencyContainer[SkinSizeMode="Medium"], UiQMediaMetadataFrameRateContainer[SkinSizeMode="Medium"]{min-width:108px;max-width:108px;}
