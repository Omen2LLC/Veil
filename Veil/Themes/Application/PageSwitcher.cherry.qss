UiQPageSwitcher
{
min-height: 48px;
max-height: 48px;
}

UiQPageSwitcherSmallSize
{
min-height: 32px;
max-height: 32px;
}

UiQPageSwitcherBackground
{
background-color: rgb(212, 105, 134);
border-style: none;
border-top: 1px solid COLOR_TINT_GRAY;
padding: 0px;
margin: 0px;
}

UiQPageSwitcherPageTabIconTextButton
{
min-width: 100px;
max-width: 100px;
image-position: center top;
background-image: none;
background-color: COLOR_OCTOPUS_GRAY;
border-style: none;
border-left: 1px solid transparent;
border-right: 1px solid transparent;
border-bottom: 2px solid transparent;
color: COLOR_DEFAULT;
text-align: center bottom;
padding: 0px 0px 2px 0px;
margin: 0px;
font-preset-name: FONT_DEFAULT;
}

UiQPageSwitcherPageTabIconOnlyButton
{
min-width: 100px;
max-width: 100px;
image-position: center top;
background-image: none;
background-color: COLOR_OCTOPUS_GRAY;
border-style: none;
border-left: 1px solid transparent;
border-right: 1px solid transparent;
border-bottom: 2px solid transparent;
color: COLOR_DEFAULT;
text-align: center bottom;
padding: 0px 0px -2px 0px;
margin: 0px;
font-preset-name: FONT_DEFAULT;
}

UiQPageSwitcherPageTabIconTextButton:hover,
UiQPageSwitcherPageTabIconTextButton:pressed,
UiQPageSwitcherPageTabIconOnlyButton:hover,
UiQPageSwitcherPageTabIconOnlyButton:pressed
{
border-bottom-color: COLOR_DEFAULT;
}

UiQPageSwitcherPageTabIconTextButton:checked,
UiQPageSwitcherPageTabIconTextButton:checked:hover,
UiQPageSwitcherPageTabIconTextButton:checked:pressed,
UiQPageSwitcherPageTabIconOnlyButton:checked,
UiQPageSwitcherPageTabIconOnlyButton:checked:hover,
UiQPageSwitcherPageTabIconOnlyButton:checked:pressed
{
background-color: black;
border-left-color: COLOR_NIGHTSKY_GRAY;
border-right-color: COLOR_NIGHTSKY_GRAY;
border-bottom-color: COLOR_CORAL_RED;
color: white;
font-preset-name: FONT_DEFAULT_SEMIBOLD;
}

UiQPageSwitcherPageTabIconTextButton[SkinId="Media"],
UiQPageSwitcherPageTabIconOnlyButton[SkinId="Media"]
{
image: url(:/PageSwitcher/MediaIcon);
}
UiQPageSwitcherPageTabIconTextButton[SkinId="Media"]:hover,
UiQPageSwitcherPageTabIconTextButton[SkinId="Media"]:pressed,
UiQPageSwitcherPageTabIconTextButton[SkinId="Media"]:checked,
UiQPageSwitcherPageTabIconOnlyButton[SkinId="Media"]:hover,
UiQPageSwitcherPageTabIconOnlyButton[SkinId="Media"]:pressed,
UiQPageSwitcherPageTabIconOnlyButton[SkinId="Media"]:checked
{
image: url(:/PageSwitcher/MediaIconOn);
}

