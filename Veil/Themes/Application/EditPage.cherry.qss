UiQEditAudioMetersMixerFrame{border-style:none;border-top:1px solid COLOR_TINT_GRAY;}
UiQTimelineViewOptionsSectionHeaderLabel{color:rgb(208, 208, 208);font-preset-name:FONT_SMOKEGRAY_SEMIBOLD;}
UiQTimelineViewOptionsGrayLabel{color:rgb(146, 146, 146);}
QMenu[SkinId="EditToolbarPreferencesMenu"]::item{height:32px;padding:0px 27px 0px 72px;font-preset-name:FONT_DEFAULT;}
QMenu[SkinId="EditToolbarPreferencesMenu"]::icon{padding:0px 30px;}
QMenu[SkinId="EditToolbarPreferencesMenu"]::right-arrow{padding:0px 10px 0px 0px;}
UiQChangeClipDurationLeftButton{border:1px solid COLOR_TINT_GRAY;border-top-left-radius:2px;border-bottom-left-radius:2px;border-top-right-radius:0px;border-bottom-right-radius:0px;color:COLOR_SMOKE_GRAY;min-width:57px;min-height:20px;max-height:20px;font-preset-name:FONT_DEFAULT;padding:-1px 12px;}
UiQChangeClipDurationRightButton{border-left-style:none;border-right:1px solid COLOR_TINT_GRAY;border-top:1px solid COLOR_TINT_GRAY;border-bottom:1px solid COLOR_TINT_GRAY;border-top-left-radius:0px;border-bottom-left-radius:0px;border-top-right-radius:2px;border-bottom-right-radius:2px;color:COLOR_SMOKE_GRAY;min-width:57px;min-height:20px;max-height:20px;font-preset-name:FONT_DEFAULT;padding:-1px 12px;}
UiQChangeClipDurationLeftButton:hover, UiQChangeClipDurationRightButton:hover, UiQChangeClipDurationLeftButton:pressed, UiQChangeClipDurationRightButton:pressed{color:white;}
UiQChangeClipDurationLeftButton:checked, UiQChangeClipDurationRightButton:checked{background-color:COLOR_OCTOPUS_GRAY;}
UiQChangeClipDurationLeftButton:disabled, UiQChangeClipDurationRightButton:disabled{border-color:COLOR_JELLYFISH_GRAY_40;color:COLOR_SQUID_GRAY_40;}
QLineEdit[SkinId="ChangeClipDurationWhiteTextLineEdit"]{color:white;font-preset-name:FONT_DEFAULT;}
UiQClipAttributesAudioMuteButton{min-width:18px;max-width:18px;min-height:18px;max-height:18px;border-style:none;image-position:center center;padding-top:2px;image:url(:/Edit/Timeline/TrackElements/Mute);}
UiQClipAttributesAudioMuteButton:pressed{image:url(:/Edit/Timeline/TrackElements/Mute_Push);}
UiQClipAttributesAudioMuteButton:disabled{image:url(:/Edit/Timeline/TrackElements/Mute_Disabled);}
UiQClipAttributesAudioMuteButton:hover{image:url(:/Edit/Timeline/TrackElements/Mute_Hover);}
UiQClipAttributesAudioMuteButton:checked{image:url(:/Edit/Timeline/TrackElements/Mute_On);}
UiQClipAttributesAudioMuteButton:checked:disabled{image:url(:/Edit/Timeline/TrackElements/Mute_On_Disabled);}
UiQClipAttributesAudioMuteButton:checked:pressed{image:url(:/Edit/Timeline/TrackElements/Mute_On_Push);}
UiQClipAttributesAudioMuteButton:checked:hover{image:url(:/Edit/Timeline/TrackElements/Mute_On_Hover);}
UiQClipAttributesAudioDeleteButton{min-width:18px;max-width:18px;min-height:18px;max-height:18px;border-style:none;image-position:center center;padding-top:2px;image:url(:/Common/Widgets/Delete);}
UiQClipAttributesAudioDeleteButton:hover{image:url(:/Common/Widgets/Delete_hover);}
UiQClipAttributesAudioDeleteButton:pressed{image:url(:/Common/Widgets/Delete_push);}
UiTiTracksView{background-color:transparent;}
UiQEditTimelineHeaderContainer{min-height:29px;max-height:29px;background-color:COLOR_DOLPHIN_GRAY;}
UiQEditTimelineHeaderContainerActive{min-height:29px;max-height:29px;background-color:COLOR_PENGUIN_GRAY;}
UiQActiveTimelineIndicatorFrame{min-height:0px;max-height:0px;border-style:none;border-bottom:1px solid COLOR_TINT_GRAY;}
UiQEditStackedTimelineTabTimelineSwitchButton{border-style:none;background-color:transparent;image-position:center center;min-height:11px;max-height:11px;min-width:11px;max-width:11px;padding-right:5px;margin:0px;image:url(:/Common/Widgets/Arrow);}
UiQEditStackedTimelineTabTimelineSwitchButton:hover{image:url(:/Common/Widgets/Arrow_hover);}
UiQEditStackedTimelineTabTimelineSwitchButton:pressed{image:url(:/Common/Widgets/Arrow_push);}
UiQEditStackedTimelineTabTimelineSwitchButton:disabled{image:url(:/Common/Widgets/Arrow_disabled);}
UiQEditStackedTimelineTabTimelineCloseButton{border-style:none;background-color:transparent;image-position:center center;min-width:10px;max-width:10px;min-height:10px;max-height:10px;padding-left:3px;image:url(:/Common/Widgets/CloseIcon);}
UiQEditStackedTimelineTabTimelineCloseButton:hover, UiQEditStackedTimelineTabTimelineCloseButton:pressed{image:url(:/Common/Widgets/CloseIcon_Hover);}
UiQEditStackedTimelineAddTabButton{border-style:none;background-color:transparent;image-position:center center;min-width:20px;max-width:20px;min-height:20px;max-height:20px;padding-left:7px;image:url(:/Common/Headers/Add);}
UiQEditStackedTimelineAddTabButton:hover{image:url(:/Common/Headers/Add_hover);}
UiQEditStackedTimelineAddTabButton:pressed{image:url(:/Common/Headers/Add_push);}
UiQEditTimelineHeaderStackButtonContainer{background-color:COLOR_PENGUIN_GRAY;}
UiQEditStackedTimelineAddStackButton{border-style:none;background-color:transparent;image-position:center center;min-height:30px;max-height:30px;min-width:40px;max-width:40px;padding:0px;margin:0px;image:url(:/Common/Headers/StackedAdd);}
UiQEditStackedTimelineAddStackButton:hover{image:url(:/Common/Headers/StackedAdd_hover);}
UiQEditStackedTimelineAddStackButton:pressed{image:url(:/Common/Headers/StackedAdd_push);}
UiQEditStackedTimelineDeleteStackButton{border-style:none;background-color:transparent;image-position:center center;min-height:30px;max-height:30px;min-width:40px;max-width:40px;padding:0px;margin:0px;image:url(:/Common/Headers/StackedDelete);}
UiQEditStackedTimelineDeleteStackButton:hover{image:url(:/Common/Headers/StackedDelete_hover);}
UiQEditStackedTimelineDeleteStackButton:pressed{image:url(:/Common/Headers/StackedDelete_push);}
UiQEditStackedTimelineActiveTabBar, UiQEditStackedTimelineActiveSourceTimelineTabBar, UiQEditStackedTimelineInactiveTabBar{padding-left:1px;}
UiQEditStackedTimelineActiveTabBar::tab, UiQEditStackedTimelineActiveSourceTimelineTabBar::tab, UiQEditStackedTimelineInactiveTabBar::tab{text-align:right;background-color:transparent;border-style:none;border-left:1px solid transparent;border-top:1px solid transparent;border-right:1px solid transparent;border-top-left-radius:4px;border-top-right-radius:4px;min-width:90px;height:27px;margin-top:1px;padding:0px 10px 0px 7px;color:COLOR_SMOKE_GRAY;}
UiQEditStackedTimelineActiveTabBar::tab:!hover, UiQEditStackedTimelineActiveSourceTimelineTabBar::tab:!hover, UiQEditStackedTimelineInactiveTabBar::tab:!hover{border-top-left-radius:0px;border-top-right-radius:0px;border-right:1px solid qlineargradient(spread:pad, x1:0, y1:0, x2:0, y2:1, stop:0.19 rgba(0, 0, 0, 0), stop:0.2 COLOR_JELLYFISH_GRAY, stop:0.8 COLOR_JELLYFISH_GRAY, stop:0.81 rgba(0, 0, 0, 0));}
UiQEditStackedTimelineActiveTabBar::tab:hover, UiQEditStackedTimelineActiveSourceTimelineTabBar::tab:hover{color:white;border-left-color:COLOR_TINT_GRAY;border-top-color:COLOR_TINT_GRAY;border-right-color:COLOR_TINT_GRAY;border-top-left-radius:4px;border-top-right-radius:4px;background-color:transparent;background-color:COLOR_STARFISH_GRAY;}
UiQEditStackedTimelineInactiveTabBar::tab:hover{color:white;border-left-color:COLOR_TINT_GRAY;border-top-color:COLOR_TINT_GRAY;border-right-color:COLOR_TINT_GRAY;border-top-left-radius:4px;border-top-right-radius:4px;background-color:transparent;}
UiQEditStackedTimelineActiveTabBar::tab:selected{color:COLOR_CORAL_RED;border-left-color:COLOR_TINT_GRAY;border-top-color:COLOR_TINT_GRAY;border-right-color:COLOR_TINT_GRAY;background-color:COLOR_ORCA_GRAY;border-top-left-radius:4px;border-top-right-radius:4px;padding-left:8px;padding-right:11px;margin-left:-1px;margin-right:-1px;}
UiQEditStackedTimelineActiveSourceTimelineTabBar::tab:selected{color:rgb(61, 148, 230);border-left-color:COLOR_TINT_GRAY;border-top-color:COLOR_TINT_GRAY;border-right-color:COLOR_TINT_GRAY;background-color:COLOR_ORCA_GRAY;border-top-left-radius:4px;border-top-right-radius:4px;padding-left:8px;padding-right:11px;margin-left:-1px;margin-right:-1px;}
UiQEditStackedTimelineInactiveTabBar::tab:selected{color:white;border-left-color:COLOR_TINT_GRAY;border-top-color:COLOR_TINT_GRAY;border-right-color:COLOR_TINT_GRAY;background-color:COLOR_ORCA_GRAY;border-top-left-radius:4px;border-top-right-radius:4px;padding-left:8px;padding-right:11px;margin-left:-1px;margin-right:-1px;}
UiQEditStackedTimelineActiveTabBar::tab:last, UiQEditStackedTimelineActiveSourceTimelineTabBar::tab:last, UiQEditStackedTimelineInactiveTabBar::tab:last{min-width:20px;max-width:20px;padding:0px 7px 0px 7px;background-color:transparent;border-color:transparent;}
UiQEditStackedTimelineActiveTabBar::tab:last:!hover, UiQEditStackedTimelineActiveSourceTimelineTabBar::tab:last:!hover, UiQEditStackedTimelineInactiveTabBar::tab:last:!hover{border-right-color:transparent;}
UiQEditStackedTimelineActiveTabBar::tear, UiQEditStackedTimelineActiveSourceTimelineTabBar::tear, UiQEditStackedTimelineInactiveTabBar::tear{background-color:transparent;border-style:none;}
UiQEditStackedTimelineActiveTabBar::scroller, UiQEditStackedTimelineActiveSourceTimelineTabBar::scroller, UiQEditStackedTimelineInactiveTabBar::scroller{width:22px;}
QScrollBar[SkinId="EditTimelineScrollBar"]{background-color:COLOR_STARFISH_GRAY;border-style:none;}
QScrollBar[SkinId="EditTimelineAudioScrollBar"]:horizontal{background-color:COLOR_STARFISH_GRAY;border-style:none;min-height:0px;max-height:0px;}
QCheckBox[SkinId="TimelineEffectCurveMenuCheckBoxAll"]{margin:4px 4px 4px 4px;}
QLabel[SkinId="TimelineEffectCurveMenuTitle"]{margin:4px 4px 4px 22px;color:white;}
UiCheckableLabel[SkinId="TimelineEffectCurveMenuHighlight"]{background-color:COLOR_OCTOPUS_GRAY;}
UiCheckableLabel[SkinId="TimelineEffectCurveMenuNoHighlight"]{background-color:transparent;}
QLabel[SkinId="TimelineEffectCurveMenuHighlight"]{color:white;padding-right:10px;}
QLabel[SkinId="TimelineEffectCurveMenuNoHighlight"]{color:COLOR_DEFAULT;padding-right:10px;}
QMenu[SkinId="EditTimelinePasteToClipOptonsMenu"]::item{margin:0px;padding-left:32px;min-height:27px;max-height:27px;}
UiQEditVoiceoverRecordingDialogFrameTop{background-color:COLOR_ORCA_GRAY;min-height:98px;max-height:98px;}
UiQEditVoiceoverRecordingDialogRecordButton{border-style:none;background-color:transparent;image-position:center center;min-width:44px;max-width:44px;min-height:44px;max-height:44px;image:url(:/Edit/Audio/RecordBtn);}
UiQEditVoiceoverRecordingDialogRecordButton:hover{image:url(:/Edit/Audio/RecordBtn_hover);}
UiQEditVoiceoverRecordingDialogRecordButton:pressed{image:url(:/Edit/Audio/RecordBtn_push);}
UiQEditVoiceoverRecordingDialogRecordButton:checked{image:url(:/Edit/Audio/RecordBtn_active);}
UiQEditVoiceoverRecordingDialogRecordButton:checked:hover{image:url(:/Edit/Audio/RecordBtn_active_hover);}
UiQEditVoiceoverRecordingDialogRecordButton:checked:pressed{image:url(:/Edit/Audio/RecordBtn_active_push);}
QComboBox[SkinId="TimelinesDiffSourceSequence"]{color:white;}
QComboBox[SkinId="TimelinesDiffSourceSequenceActive"]{color:COLOR_CORAL_RED;}
QLabel[SkinId="TimelinesDiffInfoPopup"]{image:url(:/Media/Common/InfoPopup);}
QPushButton[SkinId="TimelinesDiffTrackControlLock"]{border:none;background:transparent;image:url(:/Edit/Timeline/TrackElements/TL_Locked);}
QPushButton[SkinId="TimelinesDiffTrackControlLock"]:hover{image:url(:/Edit/Timeline/TrackElements/TL_Locked_Hover);}
QPushButton[SkinId="TimelinesDiffTrackControlLock"]:pressed{image:url(:/Edit/Timeline/TrackElements/TL_Locked_Push);}
QPushButton[SkinId="TimelinesDiffTrackControlLock"]:disabled{image:url(:/Edit/Timeline/TrackElements/TL_Locked_Disabled);}
QPushButton[SkinId="TimelinesDiffTrackControlLock"]:checked{image:url(:/Edit/Timeline/TrackElements/TL_Locked_On);}
QPushButton[SkinId="TimelinesDiffTrackControlLock"]:checked:hover{image:url(:/Edit/Timeline/TrackElements/TL_Locked_On_Hover);}
QPushButton[SkinId="TimelinesDiffTrackControlLock"]:checked:pressed{image:url(:/Edit/Timeline/TrackElements/TL_Locked_On_Push);}
QPushButton[SkinId="TimelinesDiffTrackControlLock"]:checked:disabled{image:url(:/Edit/Timeline/TrackElements/TL_Locked_On_Disabled);}
QPushButton[SkinId="TimelinesDiffTrackControlRippleEnabled"]{border:none;background:transparent;image:url(:/Edit/Timeline/TrackElements/TL_Ripple_Off);}
QPushButton[SkinId="TimelinesDiffTrackControlRippleEnabled"]:hover{image:url(:/Edit/Timeline/TrackElements/TL_Ripple_Off_Hover);}
QPushButton[SkinId="TimelinesDiffTrackControlRippleEnabled"]:pressed{image:url(:/Edit/Timeline/TrackElements/TL_Ripple_Off_Push);}
QPushButton[SkinId="TimelinesDiffTrackControlRippleEnabled"]:checked{image:url(:/Edit/Timeline/TrackElements/TL_Ripple_On);}
QPushButton[SkinId="TimelinesDiffTrackControlRippleEnabled"]:checked:hover{image:url(:/Edit/Timeline/TrackElements/TL_Ripple_On_Hover);}
QPushButton[SkinId="TimelinesDiffTrackControlRippleEnabled"]:checked:pressed{image:url(:/Edit/Timeline/TrackElements/TL_Ripple_On_Push);}
QPushButton[SkinId="TimelinesDiffTrackControlAutoSelect"]{border:none;background:transparent;image:none;color:white;font-preset-name:font(bold, 11);}
QPushButton[SkinId="TimelinesDiffTrackControlAutoSelect"]:checked:!disabled{image:url(:/Edit/Timeline/TrackElements/DestinationSelectorRed);}
UiQEditTimelineToolbarFrame QAbstractButton{background-color:COLOR_ORCA_GRAY;}